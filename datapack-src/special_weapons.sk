# Generado por special_weapons.py. Skript 2.17 sin addons. MythicMobs + PlaceholderAPI + AuraSkills.
# escala.py: armas especiales = tier 3; sus habilidades pegan x FACTOR_ARMA[3].
options:
    escala: 285.714
    # Mana y recargas: los completa special_weapons.py desde escala.py (referencia Hypixel).
    mana_destello: 50
    mana_danza: 0
    cd_danza: 15
    mana_sismo: 100
    mana_estallido: 30
    mana_curacion: 60
    cura_pct: 5
    cura_segundos: 5
    cura_radio: 7
    mana_baston_1: 30
    mana_baston_2: 50
    mana_baston_3: 90
    mana_baston_4: 150
    mana_baston_5: 200
    mana_baston_6: 0
    mana_baston_7: 0
    mana_baston_8: 0
    mana_baston_9: 0
    mana_baston_10: 0

function asw_identify(p: player):
    execute console command "execute as %name of {_p}% run function astral:special/identify"

function asw_holds(p: player, id: text) :: boolean:
    asw_identify({_p})
    if scoreboard tags of {_p} contains "astral.special.%{_id}%":
        return true
    return false

function asw_target(p: player, e: entity) :: boolean:
    if {_e} is not a living entity:
        return false
    if {_e} is {_p}:
        return false
    if {_e} is dead:
        return false
    if world of {_e} is not world of {_p}:
        return false
    if name of world of {_p} is "lobby" or "minecraft:lobby":
        return false
    if {_e} is invulnerable:
        return false
    if {_e} has metadata "NPC":
        return false
    if {_e} is a player:
        # Solo en las Arenas PvP (minijuegos.arena_worlds: la clasica, las TFT y Duelos).
        if name of world of {_p} is not __ARENAS__:
            return false
        if gamemode of {_e} is not survival:
            if gamemode of {_e} is not adventure:
                return false
        return true
    if {_e} is a wolf or cat or parrot or horse or donkey or mule or llama:
        return false
    if {_e} is an armor stand or villager or wandering trader or allay or happy ghast or camel:
        return false
    if {_e} has metadata "asw.protected":
        return false
    return true

function asw_lobby(p: player) :: boolean:
    if name of world of {_p} is "lobby" or "minecraft:lobby":
        return true
    return false

# Vivo, sin montura y fuera de espectador (sin mirar el mundo).
function asw_alive(p: player) :: boolean:
    if {_p} is not online:
        return false
    if {_p} is dead:
        return false
    if gamemode of {_p} is spectator:
        return false
    if vehicle of {_p} is set:
        return false
    return true

function asw_ready(p: player) :: boolean:
    if asw_alive({_p}) is false:
        return false
    if asw_lobby({_p}) is true:
        return false
    return true

# DeluxeMenus resuelve PlaceholderAPI con los datos del jugador y responde por consola.
# (MythicMobs 'mm test cast' desde consola leia el mana del servidor, no del jugador.)
command /asw_mana <player> <number>:
    executable by: console
    trigger:
        set {-asw.mana::%uuid of arg-1%} to arg-2

function asw_request(p: player):
    delete {-asw.mana::%uuid of {_p}%}
    execute console command "dm execute %name of {_p}% [console] asw_mana %%player_name%% %%auraskills_mana_int%%"

# Usa el mana leido por asw_request en este mismo uso.
function asw_pay(p: player, amount: number) :: boolean:
    set {_mana} to {-asw.mana::%uuid of {_p}%}
    delete {-asw.mana::%uuid of {_p}%}
    if {_mana} is not set:
        send action bar "&cNo se pudo leer el mana. Avisale a un administrador." to {_p}
        return false
    if {_mana} >= {_amount}:
        execute console command "auraskills:mana remove %name of {_p}% %{_amount}% true"
        return true
    send action bar "&cNecesitas %{_amount}% de mana." to {_p}
    return false

function asw_hurt(p: player, e: entity, amount: number):
    asw_hurt_as({_p}, {_e}, {_amount}, "player")

# tipo: "player" (blanco), "rayo" (cian), "explosion" (naranja), "sismo" (ambar).
# Cada tipo tiene su color en DamageIndicator.
function asw_hurt_as(p: player, e: entity, amount: number, kind: text):
    if asw_target({_p}, {_e}) is false:
        stop
    # El rayo ya es un % del golpe; el resto escala al tier de las armas especiales.
    if {_kind} is not "rayo":
        set {_amount} to {_amount} * {@escala}
    # Atribucion al jugador y evento Bukkit: WorldGuard y otros plugins pueden cancelar.
    set {-asw.damage::%uuid of {_p}%} to true
    set {_ticks} to no damage time of {_e}
    set no damage time of {_e} to 0 ticks
    if {_kind} is "rayo":
        set {_source} to a custom damage source:
            set the damage type to lightning bolt
            set the causing entity to {_p}
            set the direct entity to {_p}
    else if {_kind} is "explosion":
        set {_source} to a custom damage source:
            set the damage type to player explosion
            set the causing entity to {_p}
            set the direct entity to {_p}
    else if {_kind} is "sismo":
        set {_source} to a custom damage source:
            set the damage type to falling block
            set the causing entity to {_p}
            set the direct entity to {_p}
    else:
        set {_source} to a custom damage source:
            set the damage type to player attack
            set the causing entity to {_p}
            set the direct entity to {_p}
    set {_hearts} to {_amount} / 2
    damage {_e} by {_hearts} using {_source}
    set no damage time of {_e} to {_ticks}
    delete {-asw.damage::%uuid of {_p}%}

function asw_area(p: player, center: location, radius: number, amount: number, kind: text):
    loop all living entities in radius {_radius} around {_center}:
        if asw_target({_p}, loop-entity) is true:
            if {_p} has line of sight to loop-entity:
                asw_hurt_as({_p}, loop-entity, {_amount}, {_kind})

function asw_explode(p: player, center: location):
    # Solo efectos: nunca se crea TNT ni una explosion que rompa bloques.
    play sound "entity.generic.explode" with volume 0.6 and pitch 1.5 at {_center}
    set {_dimension} to asw_dimension(world of {_center})
    execute console command "execute in %{_dimension}% run particle minecraft:explosion %x-coordinate of {_center}% %y-coordinate of {_center}% %z-coordinate of {_center}% 0.3 0.3 0.3 0 3"
    asw_area({_p}, {_center}, 2, 6, "explosion")

function asw_dimension(w: world) :: text:
    set {_name} to name of {_w}
    if {_name} contains ":":
        return {_name}
    if {_name} is "world":
        return "minecraft:overworld"
    if {_name} is "world_nether":
        return "minecraft:the_nether"
    if {_name} is "world_the_end":
        return "minecraft:the_end"
    return "minecraft:%{_name}%"

function asw_clear_path(p: player, dest: location) :: boolean:
    if world of {_p} is not world of {_dest}:
        return false
    set {_start} to location of {_p}
    set {_length} to distance between {_start} and {_dest}
    set {_steps} to ceil({_length} / 0.2)
    if {_steps} < 1:
        return false
    set {_delta} to vector from {_start} to {_dest}
    loop {_steps} times:
        set {_part} to {_delta} * (loop-number / {_steps})
        set {_pos} to {_start} offset by {_part}
        set {_border} to world border of world of {_p}
        set {_middle} to world border center of {_border}
        set {_radius} to world border radius of {_border}
        if abs(x-coordinate of {_pos} - x-coordinate of {_middle}) > {_radius}:
            return false
        if abs(z-coordinate of {_pos} - z-coordinate of {_middle}) > {_radius}:
            return false
        # Volumen del cuerpo: cuatro esquinas a tres alturas cada 0,2 bloques.
        loop 12 times:
            set {_test} to {_pos} offset by vector(-0.3, 0.01, -0.3)
            set {_corner} to loop-number-2
            if {_corner} is 2 or 4 or 6 or 8 or 10 or 12:
                add 0.6 to x-coordinate of {_test}
            if {_corner} is 1 or 2 or 5 or 6 or 9 or 10:
                add 0.6 to z-coordinate of {_test}
            set {_height} to floor(((loop-number-2) - 1) / 4) * 0.89
            add {_height} to y-coordinate of {_test}
            if block at {_test} is not passable:
                return false
            if block at {_test} is lava or fire or soul fire or powder snow:
                return false
    return true

function asw_mobility(p: player) :: boolean:
    if astral_dungeon(world of {_p}) is true:
        send action bar "&cLos saltos especiales estan desactivados en mazmorras." to {_p}
        return false
    return true

# Transmisión: muestreo desde los ojos y barrido del volumen del cuerpo cada 0,2.
# Estela de particulas entre el origen y el destino (a la altura del pecho).
function asw_trail(from: location, dest: location):
    set {_dimension} to asw_dimension(world of {_from})
    set {_x0} to x-coordinate of {_from}
    set {_y0} to (y-coordinate of {_from}) + 1
    set {_z0} to z-coordinate of {_from}
    set {_ddx} to (x-coordinate of {_dest}) - {_x0}
    set {_ddy} to (y-coordinate of {_dest}) + 1 - {_y0}
    set {_ddz} to (z-coordinate of {_dest}) - {_z0}
    set {_len} to distance between {_from} and {_dest}
    set {_steps} to ceil({_len} / 0.75)
    loop {_steps} times:
        set {_t} to loop-number / {_steps}
        set {_x} to round(({_x0} + {_ddx} * {_t}) * 100) / 100
        set {_y} to round(({_y0} + {_ddy} * {_t}) * 100) / 100
        set {_z} to round(({_z0} + {_ddz} * {_t}) * 100) / 100
        execute console command "execute in %{_dimension}% run particle minecraft:reverse_portal %{_x}% %{_y}% %{_z}% 0.1 0.2 0.1 0.01 3"

function asw_blink(p: player):
    set {_dir} to vector in direction of {_p}
    set {_origin} to location of {_p}
    set {_eye} to eye location of {_p}
    set {_dest} to {_origin}
    # Dimensiones vanilla del servidor: Overworld -64; Nether y End 0.
    set {_floor} to -63
    set {_dim} to asw_dimension(world of {_p})
    if {_dim} is "minecraft:the_nether" or "minecraft:the_end":
        set {_floor} to 1
    loop 60 times:
        set {_offset} to {_dir} * (loop-number * 0.2)
        set {_ray} to {_eye} offset by {_offset}
        if block at {_ray} is not passable:
            exit loop
        set {_candidate} to {_origin} offset by {_offset}
        if y-coordinate of {_candidate} < {_floor}:
            exit loop
        if asw_clear_path({_p}, {_candidate}) is false:
            exit loop
        set {_dest} to {_candidate}
    if distance between {_origin} and {_dest} < 1:
        send action bar "&cNo hay espacio libre para teletransportarte." to {_p}
        stop
    if asw_pay({_p}, {@mana_destello}) is false:
        stop
    # Teletransporte RELATIVO de vanilla (~dx ~dy ~dz, sin tocar la rotacion): el cliente no
    # recibe una camara/posicion absoluta del server, asi que no hay tiron ni giro de camara.
    set {_dx} to round((x-coordinate of {_dest} - x-coordinate of {_origin}) * 1000) / 1000
    set {_dy} to round((y-coordinate of {_dest} - y-coordinate of {_origin}) * 1000) / 1000
    set {_dz} to round((z-coordinate of {_dest} - z-coordinate of {_origin}) * 1000) / 1000
    asw_trail({_origin}, {_dest})
    execute console command "execute as %name of {_p}% at @s run minecraft:tp @s ~%{_dx}% ~%{_dy}% ~%{_dz}%"
    # La posicion se actualiza en el tick siguiente; si algo cancelo el viaje
    # (p. ej. una region protegida), se devuelve el mana.
    wait 1 tick
    if {_p} is not online:
        stop
    if distance between (location of {_p}) and {_origin} < 0.5:
        execute console command "auraskills:mana add %name of {_p}% {@mana_destello} true"
        stop
    set fall distance of {_p} to 0
    execute console command "minecraft:attribute %name of {_p}% minecraft:movement_speed modifier remove astral:transmision"
    execute console command "minecraft:attribute %name of {_p}% minecraft:movement_speed modifier add astral:transmision 0.5 add_multiplied_base"
    set {-asw.speed::%uuid of {_p}%} to 60
    play sound "entity.enderman.teleport" with volume 0.5 and pitch 1.8 at {_p}
    set {_dimension} to asw_dimension(world of {_p})
    play sound "entity.enderman.teleport" with volume 0.5 and pitch 1.8 at {_origin}
    execute console command "execute in %{_dimension}% run particle minecraft:portal %x-coordinate of {_origin}% %y-coordinate of {_origin}% %z-coordinate of {_origin}% 0.3 0.5 0.3 0.4 20"
    set {_at} to location of {_p}
    set {_y} to y-coordinate of {_at} + 1
    execute console command "execute in %{_dimension}% run particle minecraft:portal %x-coordinate of {_at}% %{_y}% %z-coordinate of {_at}% 0.3 0.5 0.3 0.4 20"

# Varita de Curacion: {@cura_pct}% de la vida maxima por segundo durante {@cura_segundos} s, a vos y a los
# jugadores cerca. Volver a usarla reinicia el tiempo (no se acumula).
function asw_heal(p: player):
    set {_id} to uuid of {_p}
    if {-asw.healcd::%{_id}%} is set:
        if difference between now and {-asw.healcd::%{_id}%} is less than 1 second:
            stop
    if asw_pay({_p}, {@mana_curacion}) is false:
        stop
    set {-asw.healcd::%{_id}%} to now
    play sound "entity.player.levelup" with volume 0.5 and pitch 1.8 at {_p}
    loop all players in radius {@cura_radio} around {_p}:
        if loop-player is alive:
            set {-asw.regen::%uuid of loop-player%} to {@cura_segundos}
            send action bar "&aCuracion: {@cura_segundos} s" to loop-player

function asw_shadow(p: player):
    set {_id} to uuid of {_p}
    if {-asw.shadow::%{_id}%} is set:
        if difference between now and {-asw.shadow::%{_id}%} is less than {@cd_danza} seconds:
            send action bar "&7Danza del Ender: recargando ({@cd_danza} s)." to {_p}
            stop
    set {_origin} to location of {_p}
    # Se eligen una vez los seis mas cercanos al origen; cada uno aparece una sola vez.
    loop 6 times:
        delete {_best}
        set {_distance} to 13
        loop all living entities in radius 12 around {_origin}:
            if {_seen::%uuid of loop-entity%} is not true:
                if asw_target({_p}, loop-entity) is true:
                    if {_p} has line of sight to loop-entity:
                        set {_d} to distance between {_origin} and location of loop-entity
                        if {_d} < {_distance}:
                            set {_distance} to {_d}
                            set {_best} to loop-entity
        if {_best} is set:
            add {_best} to {_targets::*}
            set {_seen::%uuid of {_best}%} to true
    if size of {_targets::*} is 0:
        send action bar "&7No hay enemigos visibles a 12 bloques." to {_p}
        stop
    # Como Shadow Fury: sin mana, solo recarga.
    if {@mana_danza} > 0:
        if asw_pay({_p}, {@mana_danza}) is false:
            stop
    set {-asw.shadow::%{_id}%} to now
    set {-asw.busy::%{_id}%} to true
    loop {_targets::*}:
        if asw_ready({_p}) is false:
            exit loop
        if world of {_p} is not world of {_origin}:
            exit loop
        if asw_holds({_p}, "espada_sombras") is false:
            exit loop
        if asw_target({_p}, loop-value) is true:
            set {_target} to loop-value
            if distance between {_origin} and location of {_target} <= 12:
                if {_p} has line of sight to {_target}:
                    delete {_dest}
                    # Probar cuatro posiciones al lado del enemigo, con suelo y cuerpo libres.
                    loop 4 times:
                        set {_candidate} to location of {_target}
                        if loop-number is 1:
                            add 1.3 to x-coordinate of {_candidate}
                        if loop-number is 2:
                            subtract 1.3 from x-coordinate of {_candidate}
                        if loop-number is 3:
                            add 1.3 to z-coordinate of {_candidate}
                        if loop-number is 4:
                            subtract 1.3 from z-coordinate of {_candidate}
                        set {_floor} to {_candidate} offset by vector(0, -0.2, 0)
                        if block at {_floor} is not passable:
                            if asw_clear_path({_p}, {_candidate}) is true:
                                set {_dest} to {_candidate}
                                exit loop
                    if {_dest} is set:
                        set {_from} to location of {_p}
                        set {_dimension} to asw_dimension(world of {_p})
                        # Estela entre el punto de salida y el de llegada.
                        loop 6 times:
                            set {_t} to loop-number-2 / 6
                            set {_x} to x-coordinate of {_from} + (x-coordinate of {_dest} - x-coordinate of {_from}) * {_t}
                            set {_y} to y-coordinate of {_from} + (y-coordinate of {_dest} - y-coordinate of {_from}) * {_t} + 1
                            set {_z} to z-coordinate of {_from} + (z-coordinate of {_dest} - z-coordinate of {_from}) * {_t}
                            execute console command "execute in %{_dimension}% run particle minecraft:reverse_portal %{_x}% %{_y}% %{_z}% 0.1 0.2 0.1 0.01 4"
                        teleport {_p} to {_dest}
                        if distance between location of {_p} and {_dest} < 0.1:
                            make {_p} face {_target}
                            play sound "entity.enderman.teleport" with volume 0.4 and pitch 0.8 at {_p}
                            play sound "entity.player.attack.sweep" with volume 0.7 and pitch 1.2 at {_p}
                            set {_hit} to location of {_target}
                            set {_hy} to y-coordinate of {_hit} + 1
                            execute console command "execute in %{_dimension}% run particle minecraft:sweep_attack %x-coordinate of {_hit}% %{_hy}% %z-coordinate of {_hit}% 0.2 0.2 0.2 0 1"
                            asw_hurt({_p}, {_target}, 10)
        wait 4 ticks
    delete {-asw.busy::%{_id}%}

# Onda de 5 anillos: cada anillo levanta el suelo y golpea a lo que alcanza.
function asw_quake(p: player):
    set {_id} to uuid of {_p}
    if {-asw.quake::%{_id}%} is set:
        if difference between now and {-asw.quake::%{_id}%} is less than 6 seconds:
            send action bar "&7Hacha del Sismo: recargando (6 s)." to {_p}
            stop
    if asw_pay({_p}, {@mana_sismo}) is false:
        stop
    set {-asw.quake::%{_id}%} to now
    set {-asw.busy::%{_id}%} to true
    set {_center} to location of {_p}
    play sound "entity.iron_golem.attack" with volume 0.9 and pitch 0.5 at {_p}
    play sound "entity.generic.explode" with volume 0.4 and pitch 0.6 at {_p}
    loop 5 times:
        set {_r} to loop-number
        set {_count} to 6 * {_r}
        loop {_count} times:
            set {_angle} to loop-number-2 * (360 / {_count})
            set {_loc} to {_center} offset by vector(cos({_angle}) * {_r}, -1, sin({_angle}) * {_r})
            set {_block} to block at {_loc}
            if {_block} is solid:
                set {_data} to block data of {_block}
                if {_block} is interactable:
                    set {_data} to "minecraft:stone" parsed as block data
                spawn a block display at location of {_block}
                set {_display} to last spawned entity
                set block data of {_display} to {_data}
                add "astral.sismo" to scoreboard tags of {_display}
                set teleport duration of {_display} to 3 ticks
                add {_display} to {_rise::*}
                add {_display} to {_displays::*}
        loop {_rise::*}:
            set {_up} to location of loop-value-2
            add 0.6 to y-coordinate of {_up}
            teleport loop-value-2 to {_up}
        delete {_rise::*}
        # Golpe del anillo: lo que esta a esta distancia y todavia no fue golpeado.
        set {_reach} to {_r} + 0.5
        loop all living entities in radius {_reach} around {_center}:
            if {_hit::%uuid of loop-entity%} is not set:
                if asw_target({_p}, loop-entity) is true:
                    set {_hit::%uuid of loop-entity%} to true
                    asw_hurt_as({_p}, loop-entity, 10, "sismo")
                    push loop-entity upwards at speed 0.45
        wait 2 ticks
    wait 2 ticks
    loop {_displays::*}:
        set {_down} to location of loop-value
        subtract 0.6 from y-coordinate of {_down}
        teleport loop-value to {_down}
    delete {-asw.busy::%{_id}%}
    wait 4 ticks
    loop {_displays::*}:
        kill loop-value

function asw_wand(p: player):
    set {_id} to uuid of {_p}
    if {-asw.wand::%{_id}%} is set:
        if difference between now and {-asw.wand::%{_id}%} is less than 1 second:
            stop
    if asw_pay({_p}, {@mana_estallido}) is false:
        stop
    set {-asw.wand::%{_id}%} to now
    set {_point} to eye location of {_p}
    set {_step} to vector in direction of {_p} * 0.5
    loop 32 times:
        set {_point} to {_point} offset by {_step}
        if block at {_point} is not passable:
            set {_point} to {_point} offset by ({_step} * -1)
            asw_explode({_p}, {_point})
            stop
        loop all living entities in radius 0.8 around {_point}:
            if asw_target({_p}, loop-entity) is true:
                asw_explode({_p}, {_point})
                stop
    asw_explode({_p}, {_point})

# Bastones de Mago: cobra el mana y despues lanza el hechizo del datapack (astral:spell/cast).
function asw_staff(p: player):
    if asw_alive({_p}) is false:
        stop
    if scoreboard tags of {_p} contains "astral.spell.cd":
        send action bar "&7El hechizo se esta recargando..." to {_p}
        stop
    set {_cost} to 0
    loop 10 times:
        if scoreboard tags of {_p} contains "astral.staff.t%loop-number%":
            set {_cost} to asw_staff_cost(loop-number)
    if {_cost} <= 0:
        stop
    asw_request({_p})
    if {-asw.mana::%uuid of {_p}%} is not set:
        wait 2 ticks
    if asw_pay({_p}, {_cost}) is false:
        stop
    execute console command "execute as %name of {_p}% at @s run function astral:spell/cast"

function asw_staff_cost(t: number) :: number:
    if {_t} is 1:
        return {@mana_baston_1}
    if {_t} is 2:
        return {@mana_baston_2}
    if {_t} is 3:
        return {@mana_baston_3}
    if {_t} is 4:
        return {@mana_baston_4}
    if {_t} is 5:
        return {@mana_baston_5}
    if {_t} is 6:
        return {@mana_baston_6}
    if {_t} is 7:
        return {@mana_baston_7}
    if {_t} is 8:
        return {@mana_baston_8}
    if {_t} is 9:
        return {@mana_baston_9}
    return {@mana_baston_10}

on right click:
    asw_identify(player)
    if scoreboard tags of player contains "astral.staff":
        cancel event
        if {-asw.click::%uuid of player%} is set:
            if difference between now and {-asw.click::%uuid of player%} is less than 0.2 seconds:
                stop
        set {-asw.click::%uuid of player%} to now
        asw_staff(player)
        stop
    if scoreboard tags of player does not contain "astral.special":
        stop
    cancel event
    # Paper puede avisar el clic de las dos manos: un solo uso por clic.
    if {-asw.click::%uuid of player%} is set:
        if difference between now and {-asw.click::%uuid of player%} is less than 0.2 seconds:
            stop
    set {-asw.click::%uuid of player%} to now
    if asw_alive(player) is false:
        stop
    # En el lobby solo andan la Transmision Instantanea y la Curacion (no hacen dano); el resto avisa.
    if asw_lobby(player) is true:
        if scoreboard tags of player does not contain "astral.special.espada_destello":
            if scoreboard tags of player does not contain "astral.special.varita_curacion":
                send action bar "&cLas habilidades especiales no se usan en el lobby." to player
                stop
    if {-asw.busy::%uuid of player%} is true:
        stop
    asw_request(player)
    if {-asw.mana::%uuid of player%} is not set:
        wait 2 ticks
    if scoreboard tags of player contains "astral.special.espada_destello":
        if asw_mobility(player) is true:
            asw_blink(player)
        stop
    if scoreboard tags of player contains "astral.special.varita_curacion":
        asw_heal(player)
        stop
    if scoreboard tags of player contains "astral.special.espada_sombras":
        asw_shadow(player)
        stop
    if scoreboard tags of player contains "astral.special.hacha_terremoto":
        asw_quake(player)
        stop
    if scoreboard tags of player contains "astral.special.varita_estallido":
        asw_wand(player)

on uncancelled damage of living entity with priority monitor:
    if attacker is not a player:
        stop
    if damage cause is not entity attack:
        stop
    if damage <= 0:
        stop
    set {_p} to attacker
    if {-asw.damage::%uuid of {_p}%} is true:
        stop
    if asw_ready({_p}) is false:
        stop
    if asw_target({_p}, victim) is false:
        stop
    asw_identify({_p})
    set {_center} to location of victim
    if scoreboard tags of {_p} contains "astral.special.espada_tormenta":
        chance of 25%:
            # El rayo hace el 30% del golpe (minimo 1 punto de vida) en radio 2.
            set {_bolt} to final damage * 2 * 0.3
            if {_bolt} < 1:
                set {_bolt} to 1
            wait 1 tick
            if asw_ready({_p}) is true:
                if world of {_p} is world of {_center}:
                    strike lightning effect at {_center}
                    asw_area({_p}, {_center}, 2, {_bolt}, "rayo")
        stop
    if scoreboard tags of {_p} contains "astral.special.varita_estallido":
        asw_request({_p})
        wait 2 ticks
        if asw_pay({_p}, {@mana_estallido}) is true:
            if asw_ready({_p}) is true:
                if world of {_p} is world of {_center}:
                    asw_explode({_p}, {_center})

on load:
    loop all players:
        execute console command "minecraft:attribute %name of loop-player% minecraft:movement_speed modifier remove astral:transmision"
    delete {-asw.speed::*}
    delete {-asw.busy::*}
    delete {-asw.damage::*}
    loop all worlds:
        loop all entities in loop-world:
            if scoreboard tags of loop-entity contains "astral.sismo":
                kill loop-entity

on unload:
    loop all players:
        execute console command "minecraft:attribute %name of loop-player% minecraft:movement_speed modifier remove astral:transmision"
    delete {-asw.speed::*}
    loop all worlds:
        loop all entities in loop-world:
            if scoreboard tags of loop-entity contains "astral.sismo":
                kill loop-entity

on quit:
    delete {-asw.regen::%uuid of player%}
    delete {-asw.healcd::%uuid of player%}
    execute console command "minecraft:attribute %name of player% minecraft:movement_speed modifier remove astral:transmision"
    delete {-asw.speed::%uuid of player%}
    delete {-asw.busy::%uuid of player%}
    delete {-asw.damage::%uuid of player%}

every 1 second:
    loop all players:
        if {-asw.regen::%uuid of loop-player%} is set:
            if loop-player is alive:
                heal loop-player by (max health of loop-player) * {@cura_pct} / 100
                execute console command "execute as %name of loop-player% at @s run particle minecraft:heart ~ ~2.1 ~ 0.3 0.2 0.3 0 2"
            subtract 1 from {-asw.regen::%uuid of loop-player%}
            if {-asw.regen::%uuid of loop-player%} <= 0:
                delete {-asw.regen::%uuid of loop-player%}

on join:
    execute console command "minecraft:attribute %name of player% minecraft:movement_speed modifier remove astral:transmision"
    delete {-asw.speed::%uuid of player%}

every tick:
    loop all players:
        if {-asw.speed::%uuid of loop-player%} is set:
            subtract 1 from {-asw.speed::%uuid of loop-player%}
            if {-asw.speed::%uuid of loop-player%} <= 0:
                execute console command "minecraft:attribute %name of loop-player% minecraft:movement_speed modifier remove astral:transmision"
                delete {-asw.speed::%uuid of loop-player%}
