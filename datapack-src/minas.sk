# AstralRPG / Minas Astrales. Generado por datapack-src/minas.py: no editar a mano.
# Solo Skript + Vault (EssentialsX). No usa skript-reflect.
#
# Variables guardadas: {am.rank::uuid} (mina mas alta abierta), {am.blocks::uuid} (bloques picados
# en esa mina para abrir la siguiente) y {am.enabled}. El contador vive en memoria ({-am.b::uuid})
# y se guarda cada 30 segundos y al salir, para no escribir el archivo en cada bloque.

on load:
    # CATALOGO
    loop "am_rank", "am_here", "am_blocks", "am_goal", "am_cost", "am_minutes", "am_regen_m", "am_regen_s", "am_segments" and "am_left":
        execute console command "minecraft:scoreboard objectives add %loop-value% dummy"
    loop all players:
        am_load(loop-player)
        am_sync(loop-player)

# ---------------------------------------------------------------- utilidades

function am_world() :: world:
    return world "@WORLD@"

function am_id(loc: location) :: number:
    if name of world of {_loc} is not "@WORLD@":
        return 0
    set {_x} to x-coordinate of {_loc}
    set {_i} to floor({_x} / @SPACING@) + 1
    if {_i} is between 1 and {-am.count}:
        return {_i}
    return 0

function am_rank(p: player) :: number:
    return {am.rank::%uuid of {_p}%} ? 1

function am_spawn(i: number) :: location:
    return location(({_i} - 1) * @SPACING@ + @SPAWN_X@, @SPAWN_Y@, @SPAWN_Z@, am_world(), 0, 0)

# Dentro del pozo (coordenadas locales iguales en todos los mapas).
function am_in_pit(loc: location, i: number) :: boolean:
    set {_x} to x-coordinate of {_loc} - ({_i} - 1) * @SPACING@
    if {_x} is not between @PIT_X1@ and @PIT_X2E@:
        return false
    if y-coordinate of {_loc} is not between @PIT_Y1@ and @PIT_Y2E@:
        return false
    if z-coordinate of {_loc} is not between @PIT_Z1@ and @PIT_Z2E@:
        return false
    return true

function am_score(p: player, objective: text, value: number):
    execute console command "minecraft:scoreboard players set %name of {_p}% %{_objective}% %floor({_value})%"

function am_load(p: player):
    set {-am.b::%uuid of {_p}%} to {am.blocks::%uuid of {_p}%} ? 0

function am_save(p: player):
    set {_id} to uuid of {_p}
    if {-am.b::%{_id}%} is set:
        if {am.blocks::%{_id}%} is not {-am.b::%{_id}%}:
            set {am.blocks::%{_id}%} to {-am.b::%{_id}%}

function am_sidebar_blocks(p: player):
    set {_next} to am_rank({_p}) + 1
    set {_goal} to {-am.goal::%{_next}%} ? 0
    set {_blocks} to {-am.b::%uuid of {_p}%} ? 0
    set {_filled} to 0
    set {_shown} to {_blocks}
    if {_goal} > 0:
        if {_shown} > {_goal}:
            set {_shown} to {_goal}
        set {_filled} to floor(8 * {_shown} / {_goal})
    am_score({_p}, "am_blocks", {_shown})
    am_score({_p}, "am_segments", {_filled})
    am_score({_p}, "am_left", {_goal} - {_shown})
    set {-am.shown::%uuid of {_p}%} to {_blocks}

function am_sidebar(p: player):
    set {_next} to am_rank({_p}) + 1
    am_score({_p}, "am_rank", am_rank({_p}))
    am_score({_p}, "am_goal", {-am.goal::%{_next}%} ? 0)
    am_score({_p}, "am_cost", {-am.cost::%{_next}%} ? 0)
    am_sidebar_blocks({_p})
    am_score({_p}, "am_minutes", {am.minutes::%uuid of {_p}%} ? 0)

function am_sync(p: player):
    if name of world of {_p} is "@WORLD@":
        add "astral.mines" to scoreboard tags of {_p}
        am_sidebar({_p})
        am_score({_p}, "am_here", am_id(location of {_p}))
    else:
        remove "astral.mines" from scoreboard tags of {_p}

function am_regen_sidebar(p: player, i: number):
    set {_seconds} to 0
    set {_next} to {-am.next::%{_i}%}
    set {_now} to now
    if {am.enabled} is true:
        if {-am.building} is not true:
            if {_next} is set:
                if {_next} > {_now}:
                    set {_left} to difference between {_next} and {_now}
                    set {_seconds} to ceil({_left} / 1 second)
    am_score({_p}, "am_regen_m", floor({_seconds} / 60))
    am_score({_p}, "am_regen_s", mod({_seconds}, 60))

# ---------------------------------------------------------------- menu de minas

function am_menu(p: player):
    set {_rank} to am_rank({_p})
    set {_next} to {_rank} + 1
    set {_blocks} to {-am.b::%uuid of {_p}%} ? 0
    set {_inv} to chest inventory with 6 rows named "@MENU_TITLE@"
    set slot 4 of {_inv} to gold ingot named "&6Tu oro: &e%{_p}'s balance%" with lore "&7Abrí la siguiente mina picando" and "&7en la anterior y pagando su costo."
    set item model of slot 4 of {_inv} to "astral:viajes/blank"
    set slot 9 of {_inv} to stone named "&f&lTier I" with lore "&7Piedra con minerales."
    set item model of slot 9 of {_inv} to "astral:viajes/tier1"
    set slot 18 of {_inv} to coal block named "&e&lTier II" with lore "&7Minerales con bloques compactos."
    set item model of slot 18 of {_inv} to "astral:viajes/tier2"
    set slot 27 of {_inv} to diamond block named "&b&lTier III" with lore "&7Solo bloques compactos."
    set item model of slot 27 of {_inv} to "astral:viajes/tier3"
    loop {-am.count} times:
        set {_i} to loop-number
        set {_slot} to {-am.slot::%{_i}%}
        set {_name} to {-am.name::%{_i}%}
        set {_icon} to {-am.icon::%{_i}%}
        set {_state} to "locked"
        if {_i} <= {_rank}:
            set {_state} to "open"
            set slot {_slot} of {_inv} to {_icon} named "&f%{_name}%" with lore "&7%{-am.desc::%{_i}%}%" and "&7Valor aprox.: &6%{-am.value::%{_i}%}% oro &7por bloque" and "" and "&aClic para viajar."
        else if {_i} is {_next}:
            set {_state} to "next"
            set {_goal} to {-am.goal::%{_i}%}
            set {_cost} to {-am.cost::%{_i}%}
            set {_okb} to "&c✘"
            if {_blocks} >= {_goal}:
                set {_okb} to "&a✔"
            set {_okc} to "&c✘"
            if {_p}'s balance >= {_cost}:
                set {_okc} to "&a✔"
            set slot {_slot} of {_inv} to {_icon} named "&f%{_name}% &7(siguiente)" with lore "&7%{-am.desc::%{_i}%}%" and "" and "%{_okb}% &7Picar en %{-am.name::%{_rank}%}%: &f%{_blocks}%&7/&f%{_goal}%" and "%{_okc}% &7Costo: &6%{_cost}% oro" and "" and "&eClic para desbloquear."
            if {_i} is {-am.count}:
                set {_min} to {am.minutes::%uuid of {_p}%} ? 0
                set {_okt} to "&c✘"
                if {_min} >= {-am.finalMinutes}:
                    set {_okt} to "&a✔"
                add "%{_okt}% &7Minería activa: &f%{_min}%&7/&f%{-am.finalMinutes}% min" to lore of slot {_slot} of {_inv}
        else:
            set slot {_slot} of {_inv} to barrier named "&f%{_name}% &7(bloqueada)" with lore "&7%{-am.desc::%{_i}%}%" and "" and "&7Abrí primero las minas anteriores."
        add "&7%{-am.goal::%{_i}%}% bloques ? %{-am.cost::%{_i}%}% de oro" to lore of slot {_slot} of {_inv}
        set item model of slot {_slot} of {_inv} to "astral:viajes/mine_%{_i}%_%{_state}%"
    set slot 49 of {_inv} to barrier named "&bVolver al lobby" with lore "&7Te lleva al spawn del lobby."
    set slot 45 of {_inv} to iron pickaxe named "&eTu progreso: &f%{-am.name::%{_rank}%}%" with lore "&7Verde: mina abierta, clic para viajar." and "&eAmarillo: próxima mina, revisá el costo." and "&cRojo: abrí las anteriores primero."
    set item model of slot 45 of {_inv} to "astral:viajes/info"
    set slot 53 of {_inv} to barrier named "&cCerrar"
    set item model of slot 53 of {_inv} to "astral:viajes/cerrar"
    set slot 47 of {_inv} to spruce sapling named "&2&lBosque Astral" with lore "&7Talá árboles con hacha o motosierra." and "&7Vuelven a crecer a los 3 minutos." and "" and "&aClic para viajar."
    open {_inv} to {_p}
    set {-am.gui::%uuid of {_p}%} to "menu"

function am_travel(p: player, i: number):
    set {_rank} to am_rank({_p})
    if {_i} > {_rank} + 1:
        stop
    if {_i} is {_rank} + 1:
        set {_goal} to {-am.goal::%{_i}%}
        set {_cost} to {-am.cost::%{_i}%}
        set {_blocks} to {-am.b::%uuid of {_p}%} ? 0
        if {_blocks} < {_goal}:
            send "&cTe faltan &f%{_goal} - {_blocks}% &cbloques en %{-am.name::%{_rank}%}%." to {_p}
            stop
        if {_i} is {-am.count}:
            if ({am.minutes::%uuid of {_p}%} ? 0) < {-am.finalMinutes}:
                send "&cTe faltan minutos de minería activa en %{-am.name::%{_rank}%}%." to {_p}
                stop
        if {_p}'s balance < {_cost}:
            send "&cNecesitás &6%{_cost}% oro &cpara abrir esta mina." to {_p}
            stop
        remove {_cost} from {_p}'s balance
        set {am.rank::%uuid of {_p}%} to {_i}
        set {-am.b::%uuid of {_p}%} to 0
        set {am.blocks::%uuid of {_p}%} to 0
        send "&a&l¡Desbloqueaste %{-am.name::%{_i}%}%!" to {_p}
        play sound "entity.player.levelup" to {_p}
        am_sidebar({_p})
    close inventory of {_p}
    teleport {_p} to am_spawn({_i})
    send "&7Estás en &f%{-am.name::%{_i}%}%&7. La mina se regenera cada &f@RESET_MIN@ minutos&7." to {_p}

# ---------------------------------------------------------------- venta rapida

function am_sell_value(p: player, sell: boolean) :: number:
    set {_total} to 0
    loop 36 times:
        set {_slot} to loop-number - 1
        set {_it} to slot {_slot} of {_p}'s inventory
        if {_it} is not air:
            # Los objetos con nombre o descripcion (equipo Astral, items custom) no se venden.
            if name of {_it} is not set:
                if lore of {_it} is not set:
                    set {_price} to {-am.price::%type of {_it}%}
                    if {_price} is set:
                        add item amount of {_it} * {_price} to {_total}
                        if {_sell} is true:
                            set slot {_slot} of {_p}'s inventory to air
    return round({_total} * 100) / 100

function am_sale_menu(p: player):
    set {_value} to am_sell_value({_p}, false)
    set {_inv} to chest inventory with 5 rows named "@SALE_TITLE@"
    loop 7 times:
        set {_s} to 27 + loop-number
        set slot {_s} of {_inv} to paper named "&aVender todos mis minerales - Recibis: &6%{_value}% oro" with lore "&7Vende piedra, roca y minerales" and "&7de tu inventario. El equipo y los" and "&7objetos con nombre no se tocan." and "" and "&7Ahora te pagan: &6%{_value}% oro"
        set item model of slot {_s} of {_inv} to "astral:viajes/blank"
    set slot 1 of {_inv} to coal named "&fCarbón" with lore "&7Se vende en la Venta rápida."
    set slot 2 of {_inv} to iron ingot named "&fHierro" with lore "&7Se vende en la Venta rápida."
    set slot 3 of {_inv} to gold ingot named "&fOro" with lore "&7Se vende en la Venta rápida."
    set slot 4 of {_inv} to emerald named "&fEsmeralda" with lore "&7Se vende en la Venta rápida."
    set slot 5 of {_inv} to diamond named "&fDiamante" with lore "&7Se vende en la Venta rápida."
    set slot 35 of {_inv} to paper named "&cCerrar"
    set item model of slot 35 of {_inv} to "astral:viajes/blank"
    open {_inv} to {_p}
    set {-am.gui::%uuid of {_p}%} to "venta"

function am_sell(p: player):
    set {_total} to am_sell_value({_p}, true)
    if {_total} <= 0:
        send "&eNo tenés minerales para vender." to {_p}
        stop
    add {_total} to {_p}'s balance
    send "&aVendiste tus minerales por &6%{_total}% oro&a." to {_p}
    play sound "entity.experience_orb.pickup" to {_p}

# Comandos que usan los aldeanos de MythicMobs (corren desde la consola).
command /minasmenu <player>:
    executable by: console
    trigger:
        am_menu(arg-1)

command /minasventa <player>:
    executable by: console
    trigger:
        if am_id(location of arg-1) is 0:
            stop
        am_sale_menu(arg-1)

command /minas:
    executable by: players
    trigger:
        if name of world of player is "lobby" or "@WORLD@":
            am_menu(player)
        else:
            send "&eLas minas se abren desde el lobby (aldeano &bMinas Astrales&e)." to player

on inventory click:
    set {_gui} to {-am.gui::%uuid of player%}
    if {_gui} is not set:
        stop
    cancel event
    if clicked inventory is player's inventory:
        stop
    set {_slot} to index of event-slot
    if {_gui} is "menu":
        if {_slot} is 53:
            close inventory of player
            stop
        if {_slot} is 49:
            close inventory of player
            execute console command "spawn %name of player%"
            stop
        if {_slot} is 47:
            close inventory of player
            make player execute command "/bosque"
            stop
        set {_dest} to {-am.dest::%{_slot}%}
        if {_dest} is set:
            am_travel(player, {_dest})
    else if {_gui} is "venta":
        if {_slot} is between 28 and 34:
            close inventory of player
            am_sell(player)
        else if {_slot} is 35:
            close inventory of player

on inventory drag:
    if {-am.gui::%uuid of player%} is set:
        cancel event

on inventory close:
    delete {-am.gui::%uuid of player%}

# ---------------------------------------------------------------- picar

function am_can_break(b: block, p: player) :: boolean:
    set {_i} to am_id(location of {_b})
    if {_i} is 0:
        return false
    if {_i} > am_rank({_p}):
        return false
    if am_in_pit(location of {_b}, {_i}) is false:
        return false
    if type of {_b} is {-am.base::%{_i}%}:
        return true
    if type of {_b} is {-am.ore::%{_i}%}:
        return true
    return false

function am_count(p: player, i: number, n: number):
    if {_i} is not am_rank({_p}):
        stop
    if {_i} is {-am.count} - 1:
        set {-am.active::%uuid of {_p}%} to now
    set {_goal} to {-am.goal::%{_i} + 1%}
    if {_goal} is not set:
        stop
    set {_id} to uuid of {_p}
    set {_b} to ({-am.b::%{_id}%} ? 0) + {_n}
    if {_b} >= {_goal}:
        if ({-am.b::%{_id}%} ? 0) < {_goal}:
            send "&a&l¡Ya picaste lo necesario! &7Abrí &f%{-am.name::%{_i} + 1%}% &7desde &f/minas&7." to {_p}
            play sound "entity.player.levelup" to {_p}
        set {_b} to {_goal}
    set {-am.b::%{_id}%} to {_b}

# Area de los taladros dentro del pozo (el datapack no pica en este mundo).
# El area sale de la descripcion del taladro ("Rompe en area 3x3"): el nombre esta en el
# componente item_name, que Skript no lee, y el area real (custom_data) tampoco se puede leer.
function am_tool_area(tool: item) :: number:
    if type of {_tool} is not netherite pickaxe:
        return 0
    loop lore of {_tool}:
        set {_l} to uncolored loop-value
        if {_l} contains "Rompe en area":
            # Igual que AREA_NAMES en tools.py: 2 = 2x1, 3 = 2x2, 4 = 3x3, 5 = 4x4.
            if {_l} contains "4x4":
                return 5
            if {_l} contains "3x3":
                return 4
            if {_l} contains "2x2":
                return 3
            if {_l} contains "2x1":
                return 2
    return 0

function am_drill_area(p: player) :: number:
    return am_tool_area({_p}'s tool)

# Auto-recolectado: lo picado va directo al inventario. Si no entra, cae a los pies del jugador.
function am_give(p: player, items: items):
    loop {_items::*}:
        if {_p}'s inventory has enough space for loop-value:
            give loop-value to {_p}
        else:
            drop loop-value at {_p}

function am_drill(p: player, origin: location, area: number, dir: text):
    set {_i} to am_id({_origin})
    set {_n} to 0
    loop {-am.off::%{_area}%::%{_dir}%::*}:
        set {_b} to block at ({_origin} ~ loop-value)
        if am_can_break({_b}, {_p}) is true:
            set {_d::*} to drops of {_b} using {_p}'s tool
            set block at {_b} to air
            am_give({_p}, {_d::*})
            delete {_d::*}
            add 1 to {_n}
    if {_n} > 0:
        am_count({_p}, {_i}, {_n})

on break with priority highest:
    if name of world of event-block is not "@WORLD@":
        stop
    if player's gamemode is creative:
        if player has permission "astral.minas.admin":
            stop
    if am_can_break(event-block, player) is false:
        cancel event

on uncancelled break with priority monitor:
    if name of world of event-block is not "@WORLD@":
        stop
    if player's gamemode is not survival:
        stop
    set {_i} to am_id(location of event-block)
    am_count(player, {_i}, 1)
    set {_d::*} to drops of event-block using player's tool
    clear drops
    am_give(player, {_d::*})
    if player is sneaking:
        stop
    set {_area} to am_drill_area(player)
    if {_area} < 2:
        stop
    set {_yaw} to mod(yaw of player + 360, 360)
    if {_yaw} is between 45 and 135:
        set {_face} to "w"
    else if {_yaw} is between 135 and 225:
        set {_face} to "n"
    else if {_yaw} is between 225 and 315:
        set {_face} to "e"
    else:
        set {_face} to "s"
    # Piso (bloque mas abajo que los pies) o techo (mas arriba de la cabeza): cuadrado horizontal
    # alrededor del bloque apuntado. A la altura del cuerpo: la pared de frente.
    set {_by} to floor(y-coordinate of event-block)
    set {_py} to floor(y-coordinate of player)
    if {_by} < {_py}:
        set {_dir} to "v%{_face}%"
    else if {_by} > {_py} + 1:
        set {_dir} to "v%{_face}%"
    else:
        set {_up} to 0
        if {_by} <= {_py}:
            set {_up} to 1
        set {_dir} to "%{_face}%%{_up}%"
    set {_origin} to location of event-block
    wait 1 tick
    if player is online:
        am_drill(player, {_origin}, {_area}, {_dir})

on place:
    if name of world of event-block is "@WORLD@":
        if player's gamemode is not creative:
            cancel event

on explode:
    if name of world of event-location is "@WORLD@":
        cancel event

on bucket empty:
    if name of world of player is "@WORLD@":
        if player's gamemode is not creative:
            cancel event

on damage of player:
    if name of world of victim is "@WORLD@":
        cancel event

# ---------------------------------------------------------------- entrar y salir

on join:
    am_load(player)
    am_sync(player)

on world change:
    am_sync(player)

on quit:
    am_save(player)
    delete {-am.b::%uuid of player%}
    delete {-am.shown::%uuid of player%}
    delete {-am.gui::%uuid of player%}
    delete {-am.active::%uuid of player%}
    delete {-am.sec::%uuid of player%}

# Nadie entra por /tp o /tpa a una mina que no abrio.
on teleport:
    if name of world of event-location is not "@WORLD@":
        stop
    if player has permission "astral.minas.admin":
        if player's gamemode is creative:
            stop
    set {_i} to am_id(event-location)
    if {_i} is 0:
        cancel event
    else if {_i} > am_rank(player):
        cancel event
        send "&cTodavía no abriste esa mina." to player

every 30 seconds:
    loop all players:
        am_save(loop-player)

every 1 second:
    loop all players in am_world():
        set {_i} to am_id(location of loop-player)
        am_regen_sidebar(loop-player, {_i})
        if loop-player's gamemode is creative:
            if loop-player has permission "astral.minas.admin":
                continue
        if {_i} is 0:
            execute console command "spawn %name of loop-player%"
            continue
        if {_i} > am_rank(loop-player):
            execute console command "spawn %name of loop-player%"
            continue
        set {_id} to uuid of loop-player
        if {-am.here::%{_id}%} is not {_i}:
            set {-am.here::%{_id}%} to {_i}
            am_score(loop-player, "am_here", {_i})
        if y-coordinate of loop-player < @FALL_Y@:
            teleport loop-player to am_spawn({_i})
        # Minutos de mineria activa (picó en los ultimos 10 s) para abrir la ultima mina.
        if {-am.active::%{_id}%} is set:
            if {_i} is {-am.count} - 1:
                if difference between now and {-am.active::%{_id}%} <= 10 seconds:
                    if ({am.minutes::%{_id}%} ? 0) < {-am.finalMinutes}:
                        add 1 to {-am.sec::%{_id}%}
                        if {-am.sec::%{_id}%} >= 60:
                            delete {-am.sec::%{_id}%}
                            add 1 to {am.minutes::%{_id}%}
                            am_score(loop-player, "am_minutes", {am.minutes::%{_id}%})

# El panel lateral se actualiza cada 3 segundos y solo si cambio el contador.
every 3 seconds:
    loop all players in am_world():
        set {_id} to uuid of loop-player
        if {-am.shown::%{_id}%} is not {-am.b::%{_id}%}:
            am_sidebar_blocks(loop-player)

# ---------------------------------------------------------------- regeneracion
#
# Cada mina tiene dos moldes ya rellenos debajo del pozo (tapados por la isla). Regenerar es un
# solo /clone del molde al pozo: no recorre bloques con Skript. Se turnan los dos moldes para que
# no salga siempre igual. Solo se regenera una mina con jugadores adentro (si esta vacia, sus
# chunks ni estan cargados); al llegar alguien, si ya paso el tiempo se regenera en el momento.

function am_reset(i: number):
    set {_x} to ({_i} - 1) * @SPACING@
    loop all players in am_world():
        if am_id(location of loop-player) is {_i}:
            if am_in_pit(location of loop-player, {_i}) is true:
                teleport loop-player to am_spawn({_i})
            send action bar "&a⛏ La mina se regeneró" to loop-player
    set {-am.mold::%{_i}%} to mod(({-am.mold::%{_i}%} ? 0) + 1, 2)
    set {_y} to @MOLD_Y@ - {-am.mold::%{_i}%} * @MOLD_STEP@
    execute console command "minecraft:execute in @DIM@ run clone %{_x} + @PIT_X1@% %{_y}% @PIT_Z1@ %{_x} + @PIT_X2@% %{_y} + @PIT_H@ - 1% @PIT_Z2@ %{_x} + @PIT_X1@% @PIT_Y1@ @PIT_Z1@ replace"
    set {_t} to now
    add @RESET_MIN@ minutes to {_t}
    set {-am.next::%{_i}%} to {_t}
    delete {-am.warned::%{_i}%}

every 5 seconds:
    if {am.enabled} is not true:
        stop
    if {-am.building} is true:
        stop
    loop all players in am_world():
        set {_i} to am_id(location of loop-player)
        if {_i} > 0:
            set {_busy::%{_i}%} to true
    loop {_busy::*}:
        set {_i} to loop-index parsed as number
        if {-am.next::%{_i}%} is not set:
            am_reset({_i})
        else if {-am.next::%{_i}%} <= now:
            am_reset({_i})
        else if {-am.warned::%{_i}%} is not set:
            if difference between now and {-am.next::%{_i}%} <= 10 seconds:
                set {-am.warned::%{_i}%} to true
                loop all players in am_world():
                    if am_id(location of loop-player) is {_i}:
                        send "&eLa mina se regenera en 10 segundos." to loop-player

# Rellena los dos moldes de una mina (solo al instalar o si cambian las mezclas).
function am_build_mold(i: number, m: number):
    set {_w} to am_world()
    set {_x0} to ({_i} - 1) * @SPACING@ + @PIT_X1@
    set {_y0} to @MOLD_Y@ - {_m} * @MOLD_STEP@
    set {_base} to {-am.base::%{_i}%}
    set {_ore} to {-am.ore::%{_i}%}
    set {_chance} to {-am.chance::%{_i}%}
    execute console command "minecraft:execute in @DIM@ run forceload add %{_x0}% @PIT_Z1@ %{_x0} + @PIT_X2@ - @PIT_X1@% @PIT_Z2@"
    wait 10 ticks
    execute console command "minecraft:execute in @DIM@ run fill %{_x0}% %{_y0}% @PIT_Z1@ %{_x0} + @PIT_X2@ - @PIT_X1@% %{_y0} + @PIT_H@ - 1% @PIT_Z2@ %{-am.baseid::%{_i}%}%"
    if {_chance} > 0:
        set {_y} to {_y0}
        while {_y} < {_y0} + @PIT_H@:
            set {_x} to {_x0}
            while {_x} < {_x0} + @PIT_W@:
                set {_z} to @PIT_Z1@
                while {_z} <= @PIT_Z2@:
                    if random integer between 1 and 1000 <= {_chance} * 10:
                        set block at location({_x}, {_y}, {_z}, {_w}) to {_ore}
                    add 1 to {_z}
                add 1 to {_x}
            add 1 to {_y}
            wait 1 tick
    execute console command "minecraft:execute in @DIM@ run forceload remove %{_x0}% @PIT_Z1@ %{_x0} + @PIT_X2@ - @PIT_X1@% @PIT_Z2@"

command /minasmoldes [<integer>]:
    permission: astral.minas.admin
    trigger:
        if am_world() is not set:
            send "&cFalta crear el mundo @WORLD@ (ver instalacion.txt)." to sender
            stop
        if {-am.building} is true:
            send "&eYa se están armando los moldes." to sender
            stop
        set {-am.building} to true
        set {_from} to arg-1 ? 1
        set {_to} to arg-1 ? {-am.count}
        send "&eArmando moldes de las minas %{_from}% a %{_to}%..." to sender
        loop {-am.count} times:
            if loop-number is between {_from} and {_to}:
                # am_build_mold tiene esperas: Skript sigue sin esperarla, asi que se espacia a mano
                # para no armar las 40 a la vez.
                am_build_mold(loop-number, 0)
                am_build_mold(loop-number, 1)
                delete {-am.next::%loop-number%}
                send "&7  Molde en marcha: %{-am.name::%loop-number%}%" to sender
                wait 3 seconds
        delete {-am.building}
        send "&aMoldes listos." to sender

command /minasactivar:
    permission: astral.minas.admin
    trigger:
        if am_world() is not set:
            send "&cFalta crear el mundo @WORLD@ (ver instalacion.txt)." to sender
            stop
        set {am.enabled} to true
        send "&aMinas activadas. Cada pozo se llena cuando entra el primer jugador." to sender

command /minasreset <integer>:
    permission: astral.minas.admin
    trigger:
        if arg-1 is between 1 and {-am.count}:
            am_reset(arg-1)
            send "&aRegenerada %{-am.name::%arg-1%}%." to sender

command /minasrango <player> <integer>:
    permission: astral.minas.admin
    trigger:
        if arg-2 is between 1 and {-am.count}:
            set {am.rank::%uuid of arg-1%} to arg-2
            set {am.blocks::%uuid of arg-1%} to 0
            set {-am.b::%uuid of arg-1%} to 0
            am_sidebar(arg-1)
            send "&a%arg-1% ahora tiene abierta hasta %{-am.name::%arg-2%}%." to sender
