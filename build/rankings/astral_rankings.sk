            execute console command "tellraw %name of player% [{text:'  «Saltarin» ',color:'red'},{text:'[Equipar]',color:'green',click_event:{action:'run_command',command:'/trofeos saltarin'}}]"
        if player has permission "astral.ranking.titulo.domador_del_infinito":
