# Generado por mazmorras_copias.py: 6 copias por mazmorra, parties y 8 minutos tras el jefe.
# Variables {-...}: solo memoria. Se borran al reiniciar (nadie queda adentro tras un reinicio).

function party_miembros(p: player) :: players:
    set {_l} to {-party.lider::%uuid of {_p}%}
    if {_l} is not set:
        return {_p}
    return {-party.miembros::%{_l}%::*}

# AstralParty mantiene la API que consumen mazentrar e Infinita.
command /astralpartysync <text> <text> [<player>]:
    executable by: console
    trigger:
        if arg-1 is "clear":
            delete {-party.lider::*}
            delete {-party.miembros::*}
        else if arg-1 is "add":
            if arg-3 is set:
                set {-party.lider::%uuid of arg-3%} to arg-2
                set {-party.miembros::%arg-2%::%uuid of arg-3%} to arg-3

on load:
    wait 1 tick
    execute console command "astralpartyinternal sync"

function maz_jugadores(w: world) :: number:
    set {_c} to 0
    loop all players:
        world of loop-player is {_w}
        add 1 to {_c}
    return {_c}

function maz_entrar(p: player, key: text):
    if {_key} is "bosque":
        set {_nombre} to "Bosque Sombrio"
        set {_tp} to "1468.5 101 1570.5 0 0"
        set {_dim::1} to "bosque"
        set {_mundo::1} to "bosque"
        set {_dim::2} to "bosque_2"
        set {_mundo::2} to "bosque_2"
        set {_dim::3} to "bosque_3"
        set {_mundo::3} to "bosque_3"
        set {_dim::4} to "bosque_4"
        set {_mundo::4} to "bosque_4"
        set {_dim::5} to "bosque_5"
        set {_mundo::5} to "bosque_5"
        set {_dim::6} to "bosque_6"
        set {_mundo::6} to "bosque_6"
    if {_key} is "mina":
        set {_nombre} to "Minas Olvidadas"
        set {_tp} to "10.5 -45 -124.5 0 0"
        set {_dim::1} to "mina"
        set {_mundo::1} to "mina"
        set {_dim::2} to "mina_2"
        set {_mundo::2} to "mina_2"
        set {_dim::3} to "mina_3"
        set {_mundo::3} to "mina_3"
        set {_dim::4} to "mina_4"
        set {_mundo::4} to "mina_4"
        set {_dim::5} to "mina_5"
        set {_mundo::5} to "mina_5"
        set {_dim::6} to "mina_6"
        set {_mundo::6} to "mina_6"
    if {_key} is "tumba":
        set {_nombre} to "Tumba del Rey de Arena"
        set {_tp} to "-148.426 62 -97.473 0 0"
        set {_dim::1} to "tumba"
        set {_mundo::1} to "tumba"
        set {_dim::2} to "tumba_2"
        set {_mundo::2} to "tumba_2"
        set {_dim::3} to "tumba_3"
        set {_mundo::3} to "tumba_3"
        set {_dim::4} to "tumba_4"
        set {_mundo::4} to "tumba_4"
        set {_dim::5} to "tumba_5"
        set {_mundo::5} to "tumba_5"
        set {_dim::6} to "tumba_6"
        set {_mundo::6} to "tumba_6"
    if {_key} is "cumbre":
        set {_nombre} to "Cumbre Helada"
        set {_tp} to "-25.6 33 -23.4 49.9 0"
        set {_dim::1} to "cumbre_hielo"
        set {_mundo::1} to "cumbre_hielo"
        set {_dim::2} to "cumbre_hielo_2"
        set {_mundo::2} to "cumbre_hielo_2"
        set {_dim::3} to "cumbre_hielo_3"
        set {_mundo::3} to "cumbre_hielo_3"
        set {_dim::4} to "cumbre_hielo_4"
        set {_mundo::4} to "cumbre_hielo_4"
        set {_dim::5} to "cumbre_hielo_5"
        set {_mundo::5} to "cumbre_hielo_5"
        set {_dim::6} to "cumbre_hielo_6"
        set {_mundo::6} to "cumbre_hielo_6"
    if {_key} is "forja":
        set {_nombre} to "Corazon de la Forja"
        set {_tp} to "23.2 13 -159.4 151.5 0"
        set {_dim::1} to "forja_volcano"
        set {_mundo::1} to "forja_volcano"
        set {_dim::2} to "forja_volcano_2"
        set {_mundo::2} to "forja_volcano_2"
        set {_dim::3} to "forja_volcano_3"
        set {_mundo::3} to "forja_volcano_3"
        set {_dim::4} to "forja_volcano_4"
        set {_mundo::4} to "forja_volcano_4"
        set {_dim::5} to "forja_volcano_5"
        set {_mundo::5} to "forja_volcano_5"
        set {_dim::6} to "forja_volcano_6"
        set {_mundo::6} to "forja_volcano_6"
    if {_key} is "santuario":
        set {_nombre} to "Santuario Celestial"
        set {_tp} to "256.5 64 281.5 180 0"
        set {_dim::1} to "santuario_azeroth"
        set {_mundo::1} to "world_minecraft_santuario_azeroth"
        set {_dim::2} to "santuario_azeroth_2"
        set {_mundo::2} to "world_minecraft_santuario_azeroth_2"
        set {_dim::3} to "santuario_azeroth_3"
        set {_mundo::3} to "world_minecraft_santuario_azeroth_3"
        set {_dim::4} to "santuario_azeroth_4"
        set {_mundo::4} to "world_minecraft_santuario_azeroth_4"
        set {_dim::5} to "santuario_azeroth_5"
        set {_mundo::5} to "world_minecraft_santuario_azeroth_5"
        set {_dim::6} to "santuario_azeroth_6"
        set {_mundo::6} to "world_minecraft_santuario_azeroth_6"
    if {_key} is "fosa":
        set {_nombre} to "Fosa del Crustaceo"
        set {_tp} to "4.5 112 93.5 0 0"
        set {_dim::1} to "fosa"
        set {_mundo::1} to "fosa"
        set {_dim::2} to "fosa_2"
        set {_mundo::2} to "fosa_2"
        set {_dim::3} to "fosa_3"
        set {_mundo::3} to "fosa_3"
    if {_key} is "nave":
        set {_nombre} to "Nave del Vacio"
        set {_tp} to "-38.5 80 -17.5 -10 0"
        set {_dim::1} to "nave"
        set {_mundo::1} to "nave"
        set {_dim::2} to "nave_2"
        set {_mundo::2} to "nave_2"
        set {_dim::3} to "nave_3"
        set {_mundo::3} to "nave_3"
    if {_nombre} is not set:
        stop
    # 1) Si un companero de party ya esta adentro, va a su copia.
    set {_m::*} to party_miembros({_p})
    set {_elegida} to 0
    loop 6 times:
        set {_w} to world({_mundo::%loop-number%})
        if {_w} is set:
            loop {_m::*}:
                loop-value-2 is not {_p}
                world of loop-value-2 is {_w}
                set {_elegida} to loop-number
        if {_elegida} > 0:
            exit loop
    if {_elegida} > 0:
        set {_grupo::*} to {_p}
    else:
        set {_nueva} to true
        # 2) Primera copia vacia (y vacia hace un rato, para que se reinicien las salas).
        loop 6 times:
            set {_w} to world({_mundo::%loop-number%})
            if {_w} is set:
                if maz_jugadores({_w}) is 0:
                    if {-maz.vacia::%{_mundo::%loop-number%}%} is set:
                        if difference between {-maz.vacia::%{_mundo::%loop-number%}%} and now >= 15 seconds:
                            set {_elegida} to loop-number
                            exit loop
        if {_elegida} is 0:
            send "&cMazmorra ocupada: &flas %size of {_dim::*}% copias de %{_nombre}% estan en uso. &7Proba en unos minutos." to {_p}
            stop
        # La party entra junta: los companeros que esten en el lobby.
        loop {_m::*}:
            if loop-value is {_p}:
                add loop-value to {_grupo::*}
            else if name of world of loop-value is "lobby" or name of world of {_p}:
                add loop-value to {_grupo::*}
    set {_d} to {_dim::%{_elegida}%}
    if {_nueva} is true:
        delete {-maz.fin::%{_mundo::%{_elegida}%}%}
        delete {-maz.aviso::%{_mundo::%{_elegida}%}%}
        # Puntaje (mazmorras_puntaje.py): el reloj y las muertes empiezan con la party nueva.
        execute console command "mazpuntaje inicio %{_mundo::%{_elegida}%}%"
        execute console command "astralpartyinternal fresh %{_mundo::%{_elegida}%}%"
        if {_key} is "mina":
            execute console command "execute in minecraft:%{_d}% run function astral:tanda2/mina/fresh"
        if {_key} is "bosque":
            execute console command "execute in minecraft:%{_d}% run function astral:tanda2/bosque/fresh"
        if {_key} is "tumba":
            execute console command "execute in minecraft:%{_d}% run function astral:tanda2/tumba/fresh"
        if {_key} is "cumbre":
            execute console command "execute in minecraft:%{_d}% run function astral:tanda2/cumbre/fresh"
        if {_key} is "forja":
            execute console command "execute in minecraft:%{_d}% run function astral:tanda2/forja/fresh"
        execute console command "execute in minecraft:%{_d}% run minecraft:kill @e[type=minecraft:item,distance=0..]"
        execute console command "execute in minecraft:%{_d}% run minecraft:kill @e[type=minecraft:arrow,distance=0..]"
        execute console command "execute in minecraft:%{_d}% run minecraft:kill @e[type=minecraft:spectral_arrow,distance=0..]"
        execute console command "execute in minecraft:%{_d}% run minecraft:kill @e[type=minecraft:trident,distance=0..]"
        execute console command "execute in minecraft:%{_d}% run minecraft:kill @e[type=minecraft:experience_orb,distance=0..]"
    delete {-maz.vacia::%{_mundo::%{_elegida}%}%}
    loop {_grupo::*}:
        send "&8[&7%{_nombre}%&8] &7Entrando a la copia &f%{_elegida}%&7... &8(Para salir: /spawn)" to loop-value
        execute console command "execute in minecraft:%{_d}% run minecraft:tp %uuid of loop-value% %{_tp}%"
    # Copia nueva para el grupo: se borra lo que quedo tirado cerca de la llegada (las salas se limpian al vaciarse).
    if {_grupo::*} is set:
        wait 2 seconds
        execute console command "execute in minecraft:%{_d}% run minecraft:kill @e[type=minecraft:item,distance=0..]"
        execute console command "execute in minecraft:%{_d}% run minecraft:kill @e[type=minecraft:arrow,distance=0..]"
        execute console command "execute in minecraft:%{_d}% run minecraft:kill @e[type=minecraft:spectral_arrow,distance=0..]"
        execute console command "execute in minecraft:%{_d}% run minecraft:kill @e[type=minecraft:trident,distance=0..]"
        execute console command "execute in minecraft:%{_d}% run minecraft:kill @e[type=minecraft:experience_orb,distance=0..]"

command /mazentrar <player> <text>:
    executable by: console
    trigger:
        maz_entrar(arg-1, arg-2)

command /mazfin <text>:
    executable by: console
    trigger:
        if {-maz.fin::%arg-1%} is set:
            stop
        execute console command "astralpartyinternal victory %arg-1%"
        set {-maz.fin::%arg-1%} to now
        execute console command "mazpuntaje fin %arg-1%"
        set {_w} to world(arg-1)
        if {_w} is set:
            loop all players:
                world of loop-player is {_w}
                send "&6Ganaron! &fTienen 8 minutos para abrir el cofre. Despues vuelven al spawn." to loop-player
                play sound "ui.toast.challenge_complete" with volume 1 to loop-player

function maz_nombre(w: text) :: text:
    if {_w} is "bosque" or "bosque_2" or "bosque_3" or "bosque_4" or "bosque_5" or "bosque_6":
        return "Bosque Sombrio"
    if {_w} is "mina" or "mina_2" or "mina_3" or "mina_4" or "mina_5" or "mina_6":
        return "Minas Olvidadas"
    if {_w} is "tumba" or "tumba_2" or "tumba_3" or "tumba_4" or "tumba_5" or "tumba_6":
        return "Tumba del Rey de Arena"
    if {_w} is "cumbre_hielo" or "cumbre_hielo_2" or "cumbre_hielo_3" or "cumbre_hielo_4" or "cumbre_hielo_5" or "cumbre_hielo_6":
        return "Cumbre Helada"
    if {_w} is "forja_volcano" or "forja_volcano_2" or "forja_volcano_3" or "forja_volcano_4" or "forja_volcano_5" or "forja_volcano_6":
        return "Corazon de la Forja"
    if {_w} is "world_minecraft_santuario_azeroth" or "world_minecraft_santuario_azeroth_2" or "world_minecraft_santuario_azeroth_3" or "world_minecraft_santuario_azeroth_4" or "world_minecraft_santuario_azeroth_5" or "world_minecraft_santuario_azeroth_6":
        return "Santuario Celestial"
    if {_w} is "fosa" or "fosa_2" or "fosa_3":
        return "Fosa del Crustaceo"
    if {_w} is "nave" or "nave_2" or "nave_3":
        return "Nave del Vacio"
    return "Mazmorra"


# Mazmorras siempre de noche (sin avance del tiempo). Comandos de consola sin spam: log_admin_commands false.
function maz_noche(reglas: boolean):
    set {_w} to world("bosque")
    if {_w} is set:
        if {_reglas} is true:
            execute console command "execute in minecraft:bosque run gamerule minecraft:advance_time false"
        if time in {_w} is not 0:00:
            set time in {_w} to 0:00
    set {_w} to world("bosque_2")
    if {_w} is set:
        if {_reglas} is true:
