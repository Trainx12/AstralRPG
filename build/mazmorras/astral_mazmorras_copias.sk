on load:
    wait 5 seconds
    maz_noche(true)

on world load:
    wait 1 second
    maz_noche(true)

every 1 minute:
    maz_noche(false)

every 5 seconds:
    set {_w} to world("bosque")
    if {_w} is set:
        if maz_jugadores({_w}) is 0:
            if {-maz.vacia::bosque} is not set:
                set {-maz.vacia::bosque} to now
                # recien vacia: las salas siguen cargadas, se borra lo que quedo de la pelea
                execute console command "execute in minecraft:bosque run minecraft:kill @e[type=minecraft:item,distance=0..]"
                execute console command "execute in minecraft:bosque run minecraft:kill @e[type=minecraft:arrow,distance=0..]"
                execute console command "execute in minecraft:bosque run minecraft:kill @e[type=minecraft:spectral_arrow,distance=0..]"
                execute console command "execute in minecraft:bosque run minecraft:kill @e[type=minecraft:trident,distance=0..]"
                execute console command "execute in minecraft:bosque run minecraft:kill @e[type=minecraft:experience_orb,distance=0..]"
            delete {-maz.fin::bosque}
            delete {-maz.aviso::bosque}
        else:
            delete {-maz.vacia::bosque}
            if {-maz.fin::bosque} is set:
                set {_t} to difference between {-maz.fin::bosque} and now
                if {_t} >= 8 minutes:
                    loop all players:
                        world of loop-player is {_w}
                        send "&eSe termino el tiempo en la mazmorra: volviste al spawn." to loop-player
                        execute console command "spawn %name of loop-player%"
                    delete {-maz.fin::bosque}
                    delete {-maz.aviso::bosque}
                else if {_t} >= 7 minutes:
                    if {-maz.aviso::bosque} is not set:
                        set {-maz.aviso::bosque} to true
                        loop all players:
                            world of loop-player is {_w}
                            send "&eQueda 1 minuto: despues volves al spawn." to loop-player
