                send "&cTodavia no obtuviste este titulo." to player
                stop
            execute console command "lp user %name of player% meta setprefix 100 ""&b&l«ASTRAL»"""
            send "&aTitulo equipado: ASTRAL. Tus otros titulos siguen guardados." to player
            stop
        send "&eUsa /cosmeticos para elegir un titulo." to player
