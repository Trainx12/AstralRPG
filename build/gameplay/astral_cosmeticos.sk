# Generado por cosmeticos.py. Equipar cambia solo el prefijo cosmetico de prioridad 100.
command /titulo [<text>]:
    executable by: players
    trigger:
        if arg-1 is not set:
            execute console command "dm open cosmeticos %name of player%"
            stop
        if arg-1 is "quitar":
            execute console command "lp user %name of player% meta removeprefix 100"
            stop
        if arg-1 is "aventurero":
            if player does not have permission "astral.cosmetico.titulo.aventurero":
                send "&cTodavia no obtuviste este titulo." to player
                stop
            execute console command "lp user %name of player% meta setprefix 100 ""&7«Aventurero»"""
            send "&aTitulo equipado: Aventurero. Tus otros titulos siguen guardados." to player
            stop
        if arg-1 is "explorador":
            if player does not have permission "astral.cosmetico.titulo.explorador":
                send "&cTodavia no obtuviste este titulo." to player
                stop
            execute console command "lp user %name of player% meta setprefix 100 ""&a«Explorador»"""
            send "&aTitulo equipado: Explorador. Tus otros titulos siguen guardados." to player
            stop
        if arg-1 is "lenador":
            if player does not have permission "astral.cosmetico.titulo.lenador":
                send "&cTodavia no obtuviste este titulo." to player
                stop
            execute console command "lp user %name of player% meta setprefix 100 ""&6«Lenador»"""
            send "&aTitulo equipado: Lenador. Tus otros titulos siguen guardados." to player
            stop
        if arg-1 is "minero":
            if player does not have permission "astral.cosmetico.titulo.minero":
                send "&cTodavia no obtuviste este titulo." to player
                stop
            execute console command "lp user %name of player% meta setprefix 100 ""&8«Minero»"""
            send "&aTitulo equipado: Minero. Tus otros titulos siguen guardados." to player
            stop
        if arg-1 is "cazador":
