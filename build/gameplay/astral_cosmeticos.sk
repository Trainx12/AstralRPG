            stop
        if arg-1 is "alquimista":
            if player does not have permission "astral.cosmetico.titulo.alquimista":
                send "&cTodavia no obtuviste este titulo." to player
                stop
            execute console command "lp user %name of player% meta setprefix 100 ""&d«Alquimista»"""
            send "&aTitulo equipado: Alquimista. Tus otros titulos siguen guardados." to player
            stop
        if arg-1 is "domador":
            if player does not have permission "astral.cosmetico.titulo.domador":
                send "&cTodavia no obtuviste este titulo." to player
                stop
            execute console command "lp user %name of player% meta setprefix 100 ""&e«Domador»"""
            send "&aTitulo equipado: Domador. Tus otros titulos siguen guardados." to player
            stop
        if arg-1 is "arcano":
            if player does not have permission "astral.cosmetico.titulo.arcano":
                send "&cTodavia no obtuviste este titulo." to player
                stop
            execute console command "lp user %name of player% meta setprefix 100 ""&5«Arcano»"""
            send "&aTitulo equipado: Arcano. Tus otros titulos siguen guardados." to player
            stop
        if arg-1 is "berserker":
            if player does not have permission "astral.cosmetico.titulo.berserker":
                send "&cTodavia no obtuviste este titulo." to player
                stop
            execute console command "lp user %name of player% meta setprefix 100 ""&4«Berserker»"""
            send "&aTitulo equipado: Berserker. Tus otros titulos siguen guardados." to player
            stop
        if arg-1 is "arquero":
            if player does not have permission "astral.cosmetico.titulo.arquero":
                send "&cTodavia no obtuviste este titulo." to player
                stop
            execute console command "lp user %name of player% meta setprefix 100 ""&a«Arquero»"""
            send "&aTitulo equipado: Arquero. Tus otros titulos siguen guardados." to player
            stop
        if arg-1 is "campeon":
            if player does not have permission "astral.cosmetico.titulo.campeon":
                send "&cTodavia no obtuviste este titulo." to player
                stop
            execute console command "lp user %name of player% meta setprefix 100 ""&6&l«Campeon»"""
            send "&aTitulo equipado: Campeon. Tus otros titulos siguen guardados." to player
            stop
        if arg-1 is "senor_del_abismo":
            if player does not have permission "astral.cosmetico.titulo.senor_del_abismo":
                send "&cTodavia no obtuviste este titulo." to player
                stop
            execute console command "lp user %name of player% meta setprefix 100 ""&5&l«Senor del Abismo»"""
            send "&aTitulo equipado: Senor del Abismo. Tus otros titulos siguen guardados." to player
