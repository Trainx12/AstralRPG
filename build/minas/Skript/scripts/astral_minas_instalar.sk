import:
    java.io.File
    java.io.FileInputStream
    com.sk89q.worldedit.WorldEdit
    com.sk89q.worldedit.bukkit.BukkitAdapter
    com.sk89q.worldedit.extent.clipboard.io.ClipboardFormats
    com.sk89q.worldedit.function.operation.Operations
    com.sk89q.worldedit.math.BlockVector3
    com.sk89q.worldedit.session.ClipboardHolder

command /minaspegar <integer>:
    executable by: console
    trigger:
        set {_i} to arg-1
        if {_i} is not between 1 and 20:
            stop
        set {_world} to world "astral_minas"
        if {_world} is not set:
            send "MINAS: falta crear astral_minas." to console
            stop
        set {_maps::*} to "carbon", "cobre", "hierro", "oro", "esmeralda", "diamante", "carbon", "cobre", "hierro", "oro", "esmeralda", "diamante", "netherita", "carbon", "cobre", "hierro", "oro", "esmeralda", "diamante" and "netherita"
        set {_theme} to {_maps::%{_i}%}
        set {_file} to new File("plugins/WorldEdit/schematics/astral-mina-%{_theme}%.schem")
        set {_format} to ClipboardFormats.findByFile({_file})
        if {_format} is not set:
            send "MINAS: falta el schematic %{_theme}%." to console
            stop
        set {_stream} to new FileInputStream({_file})
        set {_reader} to {_format}.getReader({_stream})
        set {_clipboard} to {_reader}.read()
        {_reader}.close()
        if {_clipboard} is not set:
            stop
        set {_offset} to ({_i} - 1) * 512
        set {_destination} to BlockVector3.at({_offset}.intValue(), 64, 0)
        set {_adapted} to BukkitAdapter.adapt({_world})
        set {_session} to WorldEdit.getInstance().newEditSession({_adapted})
        set {_holder} to new ClipboardHolder({_clipboard})
        set {_operation} to {_holder}.createPaste({_session}).to({_destination}).ignoreAirBlocks(true).build()
        Operations.complete({_operation})
        {_session}.close()
        set {_floor} to {_world}.getBlockAt(({_offset} + 75).intValue(), 72, 76).getType().name()
        send "MINAS_PEGADO %{_i}% %{_theme}% piso=%{_floor}%" to console
