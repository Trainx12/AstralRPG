command /parkour [<text>]:
    executable by: players
    trigger:
        if arg-1 is not set:
            execute console command "dm open parkour %name of player%"
            stop
        if arg-1 is "spiral":
            astral_minijuego_ir(player, "parkour.spiral")
            stop
        if arg-1 is "spiral2":
            astral_minijuego_ir(player, "parkour.spiral2")
            stop
        if arg-1 is "paradise3":
            astral_minijuego_ir(player, "parkour.paradise3")
            stop
        if arg-1 is "colorescape":
            astral_minijuego_ir(player, "parkour.colorescape")
            stop
        if arg-1 is "magmarun":
            astral_minijuego_ir(player, "parkour.magmarun")
            stop
        if arg-1 is "batallanaval":
            astral_minijuego_ir(player, "parkour.batallanaval")
            stop
        if arg-1 is "towerdefence":
            astral_minijuego_ir(player, "parkour.towerdefence")
            stop
