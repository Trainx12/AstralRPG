# Color Escape: guardar = puzzle -> copia limpia; restaurar = copia limpia -> puzzle.
function astral_ce_clonar(dir: text):
    # Puntajes propios del mapa (no venian: el mapa se preparo sin sus datos).
    execute console command "scoreboard objectives add colorEscape dummy"
    execute console command "scoreboard objectives add advancement dummy"
    execute console command "execute in minecraft:colorescape run forceload add -32 -28 120 308"
    execute console command "execute in minecraft:colorescape run forceload add 2968 -28 3120 308"
    wait 3 seconds
    set {_z} to -28
    while {_z} <= 308:
        set {_z2} to min({_z} + 6, 308)
        if {_dir} is "guardar":
            execute console command "execute in minecraft:colorescape run clone -32 -24 %{_z}% 120 4 %{_z2}% 2968 -24 %{_z}% replace"
        else:
            execute console command "execute in minecraft:colorescape run clone 2968 -24 %{_z}% 3120 4 %{_z2}% -32 -24 %{_z}% replace"
        wait 2 ticks
        add 7 to {_z}
    if {_dir} is not "guardar":
        execute console command "execute in minecraft:colorescape run kill @e[type=item,distance=0..]"
        execute console command "scoreboard players reset * colorEscape"
        execute console command "scoreboard players reset * advancement"
    execute console command "execute in minecraft:colorescape run forceload remove -32 -28 120 308"
    execute console command "execute in minecraft:colorescape run forceload remove 2968 -28 3120 308"

command /colorescape <text>:
    permission: astral.minas.admin
    trigger:
        if arg-1 is "guardar":
            send "&eGuardando la copia limpia de Color Escape (el mapa tiene que estar sin jugar)..." to command sender
            astral_ce_clonar("guardar")
            set {astral.ce.copia} to true
        else if arg-1 is "reiniciar":
            send "&eReiniciando Color Escape..." to command sender
            astral_ce_clonar("restaurar")
            delete {astral.ce.sucio}
        else:
            send "&eUsa /colorescape guardar o /colorescape reiniciar." to command sender

# Cuando no queda nadie adentro, vuelve a como estaba.
every 5 seconds:
    if {astral.ce.sucio} is set:
        if {astral.ce.copia} is set:
            if world "colorescape" is set:
                loop all players in world "colorescape":
                    stop
                delete {astral.ce.sucio}
                astral_ce_clonar("restaurar")


command /astralpunto <text> [<text>]:
    executable by: players
    trigger:
        if player is not op:
            send "&cSolo OP." to player
            stop
        if arg-1 is "lista":
            send "&eparkour spiral &7(parkour_spiral): %{astral.punto::parkour.spiral}%" to player
            send "&eparkour spiral2 &7(parkour_spiral2): %{astral.punto::parkour.spiral2}%" to player
            send "&eparkour paradise3 &7(parkour_paradise3): %{astral.punto::parkour.paradise3}%" to player
