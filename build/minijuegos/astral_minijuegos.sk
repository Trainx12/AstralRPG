# Generado por minijuegos.py. Mundos y destinos limitados a la lista Python.
# Persistentes: puntos OP, mapa elegido y modo anterior (reconexiones/reinicios).
function astral_parkour_world(w: world) :: boolean:
    if name of {_w} is "parkour_spiral":
        return true
    return false

function astral_arena_world(w: world) :: boolean:
    if name of {_w} is "arena" or "arenas_tft":
        return true
    return false

function astral_parkour_mode(p: player):
    set {_u} to uuid of {_p}
    if astral_parkour_world(world of {_p}) is true:
        if {_p} is op:
            if gamemode of {_p} is creative:
                stop
        if {astral.minijuegos.mode::%{_u}%} is not set:
            set {astral.minijuegos.mode::%{_u}%} to gamemode of {_p}
        set gamemode of {_p} to adventure
        set food level of {_p} to 10
        set saturation of {_p} to 10
    else:
        if {astral.minijuegos.mode::%{_u}%} is set:
            if {_p} is not op:
                set gamemode of {_p} to {astral.minijuegos.mode::%{_u}%}
            else if gamemode of {_p} is not creative:
                set gamemode of {_p} to {astral.minijuegos.mode::%{_u}%}
            delete {astral.minijuegos.mode::%{_u}%}

function astral_minijuego_ir(p: player, id: text):
    if {_id} is "parkour.spiral":
        if world "parkour_spiral" is not set:
            send "&eEse mundo todavia no esta disponible." to {_p}
            stop
        set {_l} to {astral.punto::parkour.spiral}
        if {_l} is not set:
            set {_l} to location(0.5, -11, -1.5, world "parkour_spiral", 0, 0)
        if {astral.minijuegos.mode::%uuid of {_p}%} is not set:
            set {astral.minijuegos.mode::%uuid of {_p}%} to gamemode of {_p}
        set {astral.minijuegos.selected::%uuid of {_p}%} to "parkour.spiral"
        set {_x} to x-coordinate of {_l}
        set {_y} to y-coordinate of {_l}
        set {_z} to z-coordinate of {_l}
        set {_yaw} to yaw of {_l}
        set {_pitch} to pitch of {_l}
        set {_name} to name of {_p}
        set velocity of {_p} to vector(0, 0, 0)
        set fall distance of {_p} to 0
        execute console command "execute in minecraft:parkour_spiral run minecraft:tp %{_name}% %{_x}% %{_y}% %{_z}% %{_yaw}% %{_pitch}%"
        astral_parkour_mode({_p})
        stop
    if {_id} is "arena.clasica":
        if world "arena" is not set:
            send "&eEse mundo todavia no esta disponible." to {_p}
            stop
        set {_l} to {astral.punto::arena.clasica}
        if {_l} is not set:
            set {_n} to random integer between 1 and 25
            if {_n} is 1:
                set {_l} to location(-216.5, 73, -2381.5, world "arena", 0, 0)
            if {_n} is 2:
                set {_l} to location(-216.5, 73, -2376.5, world "arena", 0, 0)
            if {_n} is 3:
                set {_l} to location(-216.5, 73, -2371.5, world "arena", 0, 0)
            if {_n} is 4:
                set {_l} to location(-216.5, 73, -2366.5, world "arena", 0, 0)
            if {_n} is 5:
                set {_l} to location(-216.5, 73, -2361.5, world "arena", 0, 0)
            if {_n} is 6:
                set {_l} to location(-211.5, 73, -2381.5, world "arena", 0, 0)
            if {_n} is 7:
                set {_l} to location(-211.5, 73, -2376.5, world "arena", 0, 0)
            if {_n} is 8:
                set {_l} to location(-211.5, 73, -2371.5, world "arena", 0, 0)
            if {_n} is 9:
                set {_l} to location(-211.5, 73, -2366.5, world "arena", 0, 0)
            if {_n} is 10:
                set {_l} to location(-211.5, 73, -2361.5, world "arena", 0, 0)
            if {_n} is 11:
                set {_l} to location(-206.5, 73, -2381.5, world "arena", 0, 0)
            if {_n} is 12:
                set {_l} to location(-206.5, 73, -2376.5, world "arena", 0, 0)
            if {_n} is 13:
                set {_l} to location(-206.5, 73, -2371.5, world "arena", 0, 0)
            if {_n} is 14:
                set {_l} to location(-206.5, 73, -2366.5, world "arena", 0, 0)
            if {_n} is 15:
                set {_l} to location(-206.5, 73, -2361.5, world "arena", 0, 0)
            if {_n} is 16:
                set {_l} to location(-201.5, 73, -2381.5, world "arena", 0, 0)
            if {_n} is 17:
                set {_l} to location(-201.5, 73, -2376.5, world "arena", 0, 0)
            if {_n} is 18:
                set {_l} to location(-201.5, 73, -2371.5, world "arena", 0, 0)
