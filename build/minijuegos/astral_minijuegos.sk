                set {_l} to location(-201.5, 73, -2366.5, world "arena", 0, 0)
            if {_n} is 20:
                set {_l} to location(-201.5, 73, -2361.5, world "arena", 0, 0)
            if {_n} is 21:
                set {_l} to location(-196.5, 73, -2381.5, world "arena", 0, 0)
            if {_n} is 22:
                set {_l} to location(-196.5, 73, -2376.5, world "arena", 0, 0)
            if {_n} is 23:
                set {_l} to location(-196.5, 73, -2371.5, world "arena", 0, 0)
            if {_n} is 24:
                set {_l} to location(-196.5, 73, -2366.5, world "arena", 0, 0)
