command /parkour [<text>]:
    executable by: players
    trigger:
        if arg-1 is not set:
            execute console command "dm open parkour %name of player%"
            stop
        if arg-1 is "spiral":
            astral_minijuego_ir(player, "parkour.spiral")
            stop
        send "&eUsa /parkour para elegir un destino." to player

command /arenas [<text>]:
    executable by: players
    trigger:
        if arg-1 is not set:
            execute console command "dm open arenas %name of player%"
            stop
        if arg-1 is "clasica":
            astral_minijuego_ir(player, "arena.clasica")
            stop
        if arg-1 is "tft1":
            astral_minijuego_ir(player, "arena.tft1")
            stop
        if arg-1 is "tft2":
            astral_minijuego_ir(player, "arena.tft2")
            stop
        if arg-1 is "tft3":
            astral_minijuego_ir(player, "arena.tft3")
            stop
        send "&eUsa /arenas para elegir un destino." to player

command /astralpunto <text> [<text>]:
    executable by: players
    trigger:
        if player is not op:
            send "&cSolo OP." to player
            stop
        if arg-1 is "lista":
            send "&eparkour spiral &7(parkour_spiral): %{astral.punto::parkour.spiral}%" to player
            send "&earena clasica &7(arena): %{astral.punto::arena.clasica}%" to player
            send "&earena tft1 &7(arenas_tft): %{astral.punto::arena.tft1}%" to player
            send "&earena tft2 &7(arenas_tft): %{astral.punto::arena.tft2}%" to player
            send "&earena tft3 &7(arenas_tft): %{astral.punto::arena.tft3}%" to player
            stop
        if arg-1 is "parkour":
            if arg-2 is "spiral":
                if name of world of player is not "parkour_spiral":
                    send "&cPrimero entra al mundo parkour_spiral." to player
                    stop
                if y-coordinate of player is less than -20:
                    send "&cLa llegada debe quedar por encima del limite de rescate." to player
                    stop
                set {astral.punto::parkour.spiral} to location of player
                send "&aLlegada guardada con orientacion." to player
                stop
        if arg-1 is "arena":
            if arg-2 is "clasica":
                if name of world of player is not "arena":
                    send "&cPrimero entra al mundo arena." to player
                    stop
                if y-coordinate of player is less than 0:
                    send "&cLa llegada debe quedar por encima del limite de rescate." to player
                    stop
                set {astral.punto::arena.clasica} to location of player
                send "&aLlegada guardada con orientacion." to player
                stop
        if arg-1 is "arena":
            if arg-2 is "tft1":
                if name of world of player is not "arenas_tft":
                    send "&cPrimero entra al mundo arenas_tft." to player
                    stop
                if y-coordinate of player is less than 60:
                    send "&cLa llegada debe quedar por encima del limite de rescate." to player
                    stop
                set {astral.punto::arena.tft1} to location of player
                send "&aLlegada guardada con orientacion." to player
                stop
        if arg-1 is "arena":
            if arg-2 is "tft2":
                if name of world of player is not "arenas_tft":
                    send "&cPrimero entra al mundo arenas_tft." to player
                    stop
                if y-coordinate of player is less than 60:
                    send "&cLa llegada debe quedar por encima del limite de rescate." to player
                    stop
                set {astral.punto::arena.tft2} to location of player
                send "&aLlegada guardada con orientacion." to player
                stop
        if arg-1 is "arena":
            if arg-2 is "tft3":
                if name of world of player is not "arenas_tft":
                    send "&cPrimero entra al mundo arenas_tft." to player
                    stop
                if y-coordinate of player is less than 60:
                    send "&cLa llegada debe quedar por encima del limite de rescate." to player
                    stop
                set {astral.punto::arena.tft3} to location of player
                send "&aLlegada guardada con orientacion." to player
                stop
        send "&eUsa /astralpunto <parkour|arena> <id> o /astralpunto lista." to player

on world change:
    wait 2 ticks
    astral_parkour_mode(player)

on join:
    wait 2 ticks
    astral_parkour_mode(player)

on respawn:
    wait 2 ticks
    if name of world of player is "arena":
        set {_id} to {astral.minijuegos.selected::%uuid of player%}
        if {_id} is not "arena.clasica":
            set {_id} to "arena.clasica"
        astral_minijuego_ir(player, {_id})
    if name of world of player is "arenas_tft":
        set {_id} to {astral.minijuegos.selected::%uuid of player%}
        if {_id} is not "arena.tft1" or "arena.tft2" or "arena.tft3":
            set {_id} to "arena.tft1"
        astral_minijuego_ir(player, {_id})

on damage of player:
    if astral_parkour_world(world of victim) is true:
        cancel event

on food level change:
    if astral_parkour_world(world of player) is true:
        cancel event

every 10 ticks:
    loop all players:
        astral_parkour_mode(loop-player)
        set {_w} to name of world of loop-player
        set {_id} to {astral.minijuegos.selected::%uuid of loop-player%}
        if {_w} is "parkour_spiral":
            if {_id} is not "parkour.spiral":
                set {_id} to "parkour.spiral"
                set {astral.minijuegos.selected::%uuid of loop-player%} to {_id}
            if {_id} is "parkour.spiral":
                if y-coordinate of loop-player is less than -20:
                    if gamemode of loop-player is survival or adventure:
                        astral_minijuego_ir(loop-player, {_id})
        if {_w} is "arena":
            if {_id} is not "arena.clasica":
                set {_id} to "arena.clasica"
                set {astral.minijuegos.selected::%uuid of loop-player%} to {_id}
            if {_id} is "arena.clasica":
                if y-coordinate of loop-player is less than 0:
                    if gamemode of loop-player is survival or adventure:
                        astral_minijuego_ir(loop-player, {_id})
        if {_w} is "arenas_tft":
            if {_id} is not "arena.tft1" or "arena.tft2" or "arena.tft3":
                set {_id} to "arena.tft1"
                set {astral.minijuegos.selected::%uuid of loop-player%} to {_id}
            if {_id} is "arena.tft1":
                if y-coordinate of loop-player is less than 60:
                    if gamemode of loop-player is survival or adventure:
                        if {astral.punto::arena.tft1} is not set:
                            execute console command "spawn %name of loop-player%"
                        else:
                            astral_minijuego_ir(loop-player, {_id})
            if {_id} is "arena.tft2":
                if y-coordinate of loop-player is less than 60:
                    if gamemode of loop-player is survival or adventure:
                        if {astral.punto::arena.tft2} is not set:
                            execute console command "spawn %name of loop-player%"
                        else:
                            astral_minijuego_ir(loop-player, {_id})
            if {_id} is "arena.tft3":
                if y-coordinate of loop-player is less than 60:
                    if gamemode of loop-player is survival or adventure:
                        if {astral.punto::arena.tft3} is not set:
                            execute console command "spawn %name of loop-player%"
                        else:
                            astral_minijuego_ir(loop-player, {_id})
