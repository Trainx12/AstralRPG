        execute console command "execute in minecraft:arena run minecraft:tp %{_name}% %{_x}% %{_y}% %{_z}% %{_yaw}% %{_pitch}%"
        astral_parkour_mode({_p})
        stop
    if {_id} is "arena.tft1":
