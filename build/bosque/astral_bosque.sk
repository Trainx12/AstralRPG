command /bosqueventa <player>:
    executable by: console
    trigger:
        if name of world of arg-1 is "astral_bosque":
            am_sale_menu(arg-1)

# AstralRPG / Bosque Astral. Generado por datapack-src/bosque_talar.py: no editar a mano.
