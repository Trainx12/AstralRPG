                wait 2 ticks
        execute console command "execute in minecraft:astral_bosque run forceload remove -16 -16 127 127"
        delete {-ab.pend::*}
        send "&aBosque generado. Revisar que no falten arboles (los que fallan quedan sin molde)." to command sender

command /bosquereset:
    permission: astral.minas.admin
    trigger:
        loop 8 times:
            loop 8 times:
                ab_regrow("%loop-value-1 - 1%_%loop-value-2 - 1%")
        delete {-ab.pend::*}
        send "&aArboles regenerados." to command sender
