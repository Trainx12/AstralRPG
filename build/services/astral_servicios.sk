# Generado por datapack-src/services.py. Requiere Skript 2.17+, Vault y EconomyShopGUI.
options:
    forge-title: &f
    sale-title: &f

function asg_cost(n: number) :: number:
    if {_n} is 1:
        return 300
    if {_n} is 2:
        return 600
    if {_n} is 3:
        return 1000
    if {_n} is 4:
        return 1500
    if {_n} is 5:
        return 2000
    if {_n} is 6:
        return 3000
    if {_n} is 7:
        return 4000
    if {_n} is 8:
        return 5000
    if {_n} is 9:
        return 7500
    if {_n} is 10:
        return 10000
    return 0

