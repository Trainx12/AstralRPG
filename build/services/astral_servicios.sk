# Generado por datapack-src/services.py. Requiere Skript 2.17+, Vault y EconomyShopGUI.
options:
    forge-title: &f
    sale-title: &f

function asg_cost(n: number) :: number:
    if {_n} is 1:
        return 30000
    if {_n} is 2:
        return 75000
    if {_n} is 3:
        return 150000
    if {_n} is 4:
        return 300000
    if {_n} is 5:
        return 600000
    if {_n} is 6:
        return 1200000
    if {_n} is 7:
        return 2500000
    if {_n} is 8:
        return 5000000
    if {_n} is 9:
        return 10000000
    if {_n} is 10:
        return 25000000
    return 0

