    asg_action({_p}, {_model}, {_label}, "&7Materiales en tu inventario, dinero y probabilidad arriba." and "&7Si falla: se pierden materiales, no el equipo ni el dinero.")

function asg_rep_costo(t: number) :: number:
    if {_t} is 1:
        return 15000
    if {_t} is 2:
        return 30000
    if {_t} is 3:
        return 60000
    if {_t} is 4:
        return 120000
    if {_t} is 5:
        return 250000
    if {_t} is 6:
        return 400000
    if {_t} is 7:
        return 600000
    if {_t} is 8:
        return 850000
    if {_t} is 9:
        return 1200000
    if {_t} is 10:
        return 1600000
    return 0

function asg_rep_ver(p: player):
    set {_id} to uuid of {_p}
    set {_original} to {_p}'s tool
    set {_p}'s tool to {asg.escrow::%{_id}%}
    execute console command "execute as %name of {_p}% at @s run function astral:mejora/gui/reparar_ver"
    set {_p}'s tool to {_original}

function asg_rep_tier(p: player) :: number:
    loop 10 times:
        if {_p} has the scoreboard tag "asgui.rt%loop-number%":
            return loop-number
    return 0

function asg_reparar_boton(p: player):
    set {_inv} to {asg.gui::%uuid of {_p}%}
    asg_rep_ver({_p})
    if {_p} does not have the scoreboard tag "asgui.rep":
        set {_b} to asg_icon("astral:servicios/repair_off_0", "&7Reparar")
        set lore of {_b} to "&7Coloca un equipo gastado de AstralRPG."
        set slot 46 of {_inv} to {_b}
        loop 3 times:
            set {_s} to 46 + loop-number
            set {_tile} to asg_icon("astral:servicios/repair_off_%loop-number%", "&7Reparar")
            set lore of {_tile} to lore of {_b}
            set slot {_s} of {_inv} to {_tile}
        stop
    set {_t} to asg_rep_tier({_p})
    set {_state} to "ready"
    set {_label} to "&a&lReparar &7(tier %{_t}%)"
    if {_p} does not have the scoreboard tag "asgui.repmat":
        set {_state} to "missing"
        set {_label} to "&c&lReparar &7(tier %{_t}%) - faltan materiales"
    if balance of {_p} < asg_rep_costo({_t}):
        set {_state} to "missing"
        set {_label} to "&c&lReparar &7(tier %{_t}%) - falta dinero"
    set {_b} to asg_icon("astral:servicios/repair_%{_state}%_0", {_label})
    if {_t} is 1:
        set lore of {_b} to "&7Deja el equipo como nuevo.", "&eCosto: 15000$", "&eMaterial: Fragmento Astral x1" and "&8(el material se busca en tu inventario)"
    if {_t} is 2:
        set lore of {_b} to "&7Deja el equipo como nuevo.", "&eCosto: 30000$", "&eMaterial: Polvo Astral x1" and "&8(el material se busca en tu inventario)"
    if {_t} is 3:
        set lore of {_b} to "&7Deja el equipo como nuevo.", "&eCosto: 60000$", "&eMaterial: Cristal Arcano Refinado x1" and "&8(el material se busca en tu inventario)"
    if {_t} is 4:
        set lore of {_b} to "&7Deja el equipo como nuevo.", "&eCosto: 120000$", "&eMaterial: Chispa Astral x1" and "&8(el material se busca en tu inventario)"
    if {_t} is 5:
        set lore of {_b} to "&7Deja el equipo como nuevo.", "&eCosto: 250000$", "&eMaterial: Nucleo Astral x1" and "&8(el material se busca en tu inventario)"
    if {_t} is 6:
        set lore of {_b} to "&7Deja el equipo como nuevo.", "&eCosto: 400000$", "&eMaterial: Fragmento de Ocaso x1" and "&8(el material se busca en tu inventario)"
    if {_t} is 7:
        set lore of {_b} to "&7Deja el equipo como nuevo.", "&eCosto: 600000$", "&eMaterial: Esquirla de Eclipse x1" and "&8(el material se busca en tu inventario)"
    if {_t} is 8:
        set lore of {_b} to "&7Deja el equipo como nuevo.", "&eCosto: 850000$", "&eMaterial: Nucleo de Supernova x1" and "&8(el material se busca en tu inventario)"
    if {_t} is 9:
        set lore of {_b} to "&7Deja el equipo como nuevo.", "&eCosto: 1200000$", "&eMaterial: Esencia del Vacio x1" and "&8(el material se busca en tu inventario)"
    if {_t} is 10:
        set lore of {_b} to "&7Deja el equipo como nuevo.", "&eCosto: 1600000$", "&eMaterial: Corazon del Fin x1" and "&8(el material se busca en tu inventario)"
    set slot 46 of {_inv} to {_b}
    loop 3 times:
        set {_s} to 46 + loop-number
        set {_tile} to asg_icon("astral:servicios/repair_%{_state}%_%loop-number%", {_label})
        set lore of {_tile} to lore of {_b}
        set slot {_s} of {_inv} to {_tile}

function asg_open(p: player, mode: text):
    close {_p}'s inventory
    asg_return({_p})
    set {_id} to uuid of {_p}
    if {_mode} is "forge":
        set {_inv} to a new chest inventory with 6 rows named colored "{@forge-title}"
    else:
        set {_inv} to a new chest inventory with 6 rows named colored "{@sale-title}"
    set {asg.gui::%{_id}%} to {_inv}
    set {asg.mode::%{_id}%} to {_mode}
    set slot 8 of {_inv} to book named "&eComo usar"
    set lore of slot 8 of {_inv} to "&71. Coloca el objeto en el recuadro.", "&72. Revisa los requisitos o el precio.", "&73. Pulsa el boton para confirmar." and "&7Cerrar o desconectarte devuelve tu objeto."
    set slot 45 of {_inv} to asg_icon("astral:menu/icon_back", "&eDevolver objeto")
    set slot 53 of {_inv} to asg_icon("astral:menu/icon_close", "&cCerrar y devolver")
    # Reforja de gemas (gemas.py, 7d): boton GEMAS en 51-52.
    if {_mode} is "forge":
        loop 3 times:
            set {_g} to asg_icon("astral:servicios/gems_%loop-number - 1%", "&d&lReforja de gemas")
            set lore of {_g} to "&7Engarza gemas en tus armas y armaduras." and "&7Tu equipo vuelve a tu inventario."
            set slot (49 + loop-number) of {_inv} to {_g}
        set slot 45 of {_inv} to asg_icon("astral:servicios/forja_atras_0", "&eDevolver objeto")
        set slot 53 of {_inv} to asg_icon("astral:servicios/forja_cerrar_0", "&cCerrar y devolver")
    asg_refresh({_p})
    open {_inv} to {_p}

command /astralherrero [<player>]:
    trigger:
        if arg-1 is set:
            if sender is not console:
                stop
            asg_open(arg-1, "forge")
        else:
            if sender is a player:
                asg_open(player, "forge")

command /astralventa [<player>]:
    trigger:
        if arg-1 is set:
            if sender is not console:
                stop
            asg_open(arg-1, "sale")
        else:
            if sender is a player:
                asg_open(player, "sale")

on inventory click:
    set {_id} to uuid of player
    set {_inv} to {asg.gui::%{_id}%}
    if {_inv} is not set:
        stop
    if player's current inventory is not {_inv}:
        asg_return(player)
        stop
    cancel event
    if {asg.busy::%{_id}%} is true:
        stop
    set {_target} to 20
    if {asg.mode::%{_id}%} is "sale":
        set {_target} to 24
    if clicked inventory is player's inventory:
        if click type is left mouse button or right mouse button:
            uncancel event
            stop
        if click type is left mouse button with shift or right mouse button with shift:
            if {asg.escrow::%{_id}%} is not set:
                set {_item} to event-slot
                if {_item} is not air:
                    if {asg.mode::%{_id}%} is "forge":
                        if item amount of {_item} is not 1:
                            send "&cColoca una sola pieza de equipo." to player
                            stop
                    set {asg.escrow::%{_id}%} to {_item}
                    set event-slot to air
                    delete {asg.notice::%{_id}%}
                    asg_refresh(player)
        stop
    if clicked inventory is not {_inv}:
        stop
    if click type is not left mouse button:
        if click type is not right mouse button:
            stop
    set {_slot} to index of event-slot
    if {_slot} is 53:
        close player's inventory
        stop
    if {_slot} is 45:
        set {_saved} to {asg.escrow::%{_id}%}
        delete {asg.escrow::%{_id}%}
        set slot {_target} of {_inv} to air
        delete {asg.notice::%{_id}%}
        if {_saved} is set:
            if player has enough space for {_saved}:
                give {_saved} to player
            else:
                drop {_saved} at player's location
        asg_refresh(player)
        stop
    if {_slot} is {_target}:
        set {_cursor} to cursor slot of player
        set {_old} to {asg.escrow::%{_id}%}
        if {_cursor} is air:
            if {_old} is set:
                delete {asg.escrow::%{_id}%}
                set slot {_target} of {_inv} to air
                set cursor slot of player to {_old}
        else:
            if {asg.mode::%{_id}%} is "forge":
                if item amount of {_cursor} is not 1:
                    send "&cColoca una sola pieza de equipo." to player
                    stop
            set {asg.escrow::%{_id}%} to {_cursor}
            if {_old} is set:
                set cursor slot of player to {_old}
            else:
                set cursor slot of player to air
        delete {asg.notice::%{_id}%}
        asg_refresh(player)
        stop
    if {asg.mode::%{_id}%} is "sale":
        if {_slot} is between 41 and 44:
            set {_item} to {asg.escrow::%{_id}%}
            if {_item} is not set:
                stop
            if asg_sale_allowed({_item}) is false:
                send "&cEl vendedor no admite ese objeto. Podes retirarlo o cerrar." to player
                stop
            set {asg.busy::%{_id}%} to true
            set {_original} to player's tool
            set {_amount} to item amount of {_item}
            set {_money} to balance of player
            set player's tool to {_item}
            # La Estrella del Menu bloquea sellall (para no vender la estrella): esta venta es
            # solo del objeto depositado y la habilita con esta marca (08/11/2026).
            set {-asg.selling::%{_id}%} to true
            make player execute command "economyshopgui:sellall hand"
            delete {-asg.selling::%{_id}%}
            set {_rest} to player's tool
            set player's tool to {_original}
            delete {asg.escrow::%{_id}%}
            if {_rest} is not air:
                set {asg.escrow::%{_id}%} to {_rest}
            set slot 24 of {_inv} to {_rest}
            delete {asg.busy::%{_id}%}
            if balance of player > {_money}:
                send "&aVenta completada. Tu saldo y el objeto se actualizaron." to player
            else:
                send "&eNo se pudo vender. Tu objeto se conserva en el recuadro." to player
            asg_refresh(player)
        stop
    if {_slot} is between 50 and 52:
        if {asg.mode::%{_id}%} is "forge":
            close player's inventory
            wait 1 tick
            execute console command "astralreforja %name of player%"
        stop
    if {_slot} is between 46 and 49:
        if {asg.mode::%{_id}%} is not "forge":
            stop
        if {asg.escrow::%{_id}%} is not set:
            stop
        asg_rep_ver(player)
        if player does not have the scoreboard tag "asgui.rep":
            send "&eEse equipo no esta gastado o no es de AstralRPG." to player
            stop
        if player does not have the scoreboard tag "asgui.repmat":
            send "&cTe falta el material para reparar (mira el boton)." to player
            stop
        set {_c} to asg_rep_costo(asg_rep_tier(player))
        if balance of player < {_c}:
            send "&cNecesitas %{_c}%$ para reparar." to player
            stop
        set {asg.busy::%{_id}%} to true
        set {_original} to player's tool
        set player's tool to {asg.escrow::%{_id}%}
        execute console command "execute as %player% at @s run tag @s remove asgui.reparado"
        execute console command "execute as %player% at @s run function astral:mejora/gui/reparar"
        set {_result} to player's tool
        set player's tool to {_original}
        set {asg.escrow::%{_id}%} to {_result}
        set slot 20 of {_inv} to {_result}
        if player has the scoreboard tag "asgui.reparado":
            remove {_c} from player's balance
            send "&aEquipo reparado por %{_c}%$." to player
        delete {asg.busy::%{_id}%}
        asg_refresh(player)
        stop
    if {_slot} is between 38 and 42:
        if {asg.escrow::%{_id}%} is not set:
            stop
        asg_refresh(player)
        if player does not have the scoreboard tag "asgui.ready":
            send "&cRevisa el equipo y los materiales indicados." to player
            stop
        set {_n} to 0
        loop 10 times:
            if player has the scoreboard tag "asgui.next%loop-number%":
                set {_n} to loop-number
        set {_cost} to asg_cost({_n})
        if {_n} is 0:
            stop
        if balance of player < {_cost}:
            send "&cNecesitas %{_cost}%$ para este intento." to player
            stop
        set {asg.busy::%{_id}%} to true
        set {_original} to player's tool
        set player's tool to {asg.escrow::%{_id}%}
        execute console command "execute as %player% at @s run function astral:mejora/gui/apply"
        set {_result} to player's tool
        set player's tool to {_original}
        set {asg.escrow::%{_id}%} to {_result}
        set slot 20 of {_inv} to {_result}
        if player has the scoreboard tag "asgui.success":
            remove {_cost} from player's balance
            set {asg.notice::%{_id}%} to "ok%{_n}%"
        else if player has the scoreboard tag "asgui.attempted":
            set {asg.notice::%{_id}%} to "fail%{_n}%"
        delete {asg.busy::%{_id}%}
        asg_refresh(player)

on inventory drag:
    if {asg.gui::%uuid of player%} is set:
        if player's current inventory is {asg.gui::%uuid of player%}:
            cancel event

on inventory close:
    if {asg.gui::%uuid of player%} is set:
        asg_return(player)

on quit:
    if {asg.gui::%uuid of player%} is set:
        asg_return(player)

on join:
    if {asg.escrow::%uuid of player%} is set:
        wait 1 tick
        asg_return(player)

on unload:
    loop all players:
        if {asg.gui::%uuid of loop-player%} is set:
            asg_return(loop-player)
            close loop-player's inventory

every 10 ticks:
    loop all players:
        if {asg.gui::%uuid of loop-player%} is set:
            asg_refresh(loop-player)
