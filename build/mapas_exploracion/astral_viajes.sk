# Generado por viajes_mazmorras.py. No acepta un jugador destino ni comandos del usuario.
command /mazmorras [<text>]:
    executable by: players
    description: Viaja a una mazmorra descubierta.
    trigger:
        if arg-1 is not set:
            execute console command "dm open mazmorras %name of player%"
            stop
        set {_destino} to arg-1
        if {_destino} is "minas":
            set {_destino} to "mina"
        if {_destino} is "bosque":
            if player does not have permission "astral.descubierto.bosque":
                send "&cPrimero debes encontrar y hablar con el aldeano de esta mazmorra." to player
                stop
            execute console command "execute in minecraft:bosque run minecraft:tp %name of player% 1468.5 101 1570.5 0 0"
            stop
        if {_destino} is "mina":
            if player does not have permission "astral.descubierto.mina":
                send "&cPrimero debes encontrar y hablar con el aldeano de esta mazmorra." to player
                stop
            execute console command "execute in minecraft:mina run minecraft:tp %name of player% 10.5 -45 -124.5 0 0"
            stop
        if {_destino} is "tumba":
            if player does not have permission "astral.descubierto.tumba":
                send "&cPrimero debes encontrar y hablar con el aldeano de esta mazmorra." to player
                stop
            execute console command "execute in minecraft:tumba run minecraft:tp %name of player% -148.426 62 -97.473 0 0"
            stop
        if {_destino} is "cumbre":
            if player does not have permission "astral.descubierto.cumbre":
                send "&cPrimero debes encontrar y hablar con el aldeano de esta mazmorra." to player
                stop
            execute console command "execute in minecraft:cumbre_hielo run minecraft:tp %name of player% -25.6 33 -23.4 49.9 0"
            stop
        if {_destino} is "forja":
            if player does not have permission "astral.descubierto.forja":
                send "&cPrimero debes encontrar y hablar con el aldeano de esta mazmorra." to player
                stop
            execute console command "execute in minecraft:forja_volcano run minecraft:tp %name of player% 23.2 13 -159.4 151.5 0"
            stop
        if {_destino} is "santuario":
            if player does not have permission "astral.descubierto.santuario":
                send "&cPrimero debes encontrar y hablar con el aldeano de esta mazmorra." to player
                stop
            execute console command "execute in minecraft:santuario_azeroth run minecraft:tp %name of player% 256.5 64 281.5 180 0"
            stop
        send "&eDestinos: bosque, mina, tumba, cumbre, forja y santuario." to player

# Rutas de exploracion publicas. El viaje directo a la mazmorra se controla por separado.
command /expediciones [<text>]:
    aliases: expedicion
    executable by: players
    trigger:
        if arg-1 is not set:
            execute console command "dm open expediciones %name of player%"
            stop
        if arg-1 is "bosque":
            execute console command "execute in minecraft:cavernas run minecraft:tp %name of player% 172.5 102 89.5 0 0"
            stop
        if arg-1 is "tumba":
            if player is not op:
                if player does not have permission "astral.completada.mina":
                    send "&cPrimero termina la mazmorra &fMinas Olvidadas&c." to player
                    stop
            execute console command "execute in minecraft:exp_desierto run minecraft:tp %name of player% 180.233 102 134.266 -124.8 0"
            stop
        if arg-1 is "mina":
            if player is not op:
                if player does not have permission "astral.completada.bosque":
                    send "&cPrimero termina la mazmorra &fBosque Sombrio&c." to player
                    stop
            execute console command "execute in minecraft:cavernas run minecraft:tp %name of player% 172.5 102 89.5 0 0"
            stop
        if arg-1 is "cumbre":
            if player is not op:
                if player does not have permission "astral.completada.tumba":
                    send "&cPrimero termina la mazmorra &fTumba del Rey de Arena&c." to player
                    stop
            execute console command "execute in minecraft:exp_nieve run minecraft:tp %name of player% 16.5 83 10.5 0 0"
            stop
        if arg-1 is "forja":
            if player is not op:
                if player does not have permission "astral.completada.cumbre":
                    send "&cPrimero termina la mazmorra &fCumbre Helada&c." to player
                    stop
            execute console command "execute in minecraft:forja run minecraft:tp %name of player% 1536.5 222 1900.5 0 0"
            stop
        if arg-1 is "santuario":
            if player is not op:
                if player does not have permission "astral.completada.forja":
                    send "&cPrimero termina la mazmorra &fCorazon de la Forja&c." to player
                    stop
            execute console command "execute in minecraft:exp_santuario run minecraft:tp %name of player% 26.5 103 -31.5 180 0"
            stop
        send "&eUsa /expediciones para elegir un destino." to player
