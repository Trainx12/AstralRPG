function agem_leer(p: player):
    set {_id} to uuid of {_p}
    delete {-agem.t::%{_id}%}
    delete {-agem.r::%{_id}%}
    delete {-agem.var::%{_id}%}
    delete {-agem.has::%{_id}%::*}
    delete {-agem.ran::%{_id}%::*}
    delete {-agem.gt::%{_id}%}
    delete {-agem.gq::%{_id}%}
    set {_it} to {agem.item::%{_id}%}
    if {_it} is set:
        agem_run({_p}, {_it}, "gemas/gui/ver")
        if {_p} has the scoreboard tag "asgem.valid":
            set {-agem.var::%{_id}%} to "arma"
            if {_p} has the scoreboard tag "asgem.armadura":
                set {-agem.var::%{_id}%} to "armadura"
            if {_p} has the scoreboard tag "asgem.t1":
                set {-agem.t::%{_id}%} to 1
                set {-agem.r::%{_id}%} to 1
            if {_p} has the scoreboard tag "asgem.t2":
                set {-agem.t::%{_id}%} to 2
                set {-agem.r::%{_id}%} to 1
            if {_p} has the scoreboard tag "asgem.t3":
                set {-agem.t::%{_id}%} to 3
                set {-agem.r::%{_id}%} to 1
            if {_p} has the scoreboard tag "asgem.t4":
                set {-agem.t::%{_id}%} to 4
                set {-agem.r::%{_id}%} to 2
            if {_p} has the scoreboard tag "asgem.t5":
                set {-agem.t::%{_id}%} to 5
                set {-agem.r::%{_id}%} to 2
            if {_p} has the scoreboard tag "asgem.t6":
                set {-agem.t::%{_id}%} to 6
                set {-agem.r::%{_id}%} to 2
            if {_p} has the scoreboard tag "asgem.t7":
                set {-agem.t::%{_id}%} to 7
                set {-agem.r::%{_id}%} to 2
            if {_p} has the scoreboard tag "asgem.t8":
                set {-agem.t::%{_id}%} to 8
                set {-agem.r::%{_id}%} to 3
            if {_p} has the scoreboard tag "asgem.t9":
                set {-agem.t::%{_id}%} to 9
                set {-agem.r::%{_id}%} to 3
            if {_p} has the scoreboard tag "asgem.t10":
                set {-agem.t::%{_id}%} to 10
                set {-agem.r::%{_id}%} to 3
            set {_k} to 0
            if {_p} has the scoreboard tag "asgem.has.rubi":
                add 1 to {_k}
                set {-agem.ran::%{_id}%::%{_k}%} to "rubi"
                if {_p} has the scoreboard tag "asgem.q.rubi.1":
                    set {-agem.has::%{_id}%::rubi} to 1
                if {_p} has the scoreboard tag "asgem.q.rubi.2":
                    set {-agem.has::%{_id}%::rubi} to 2
                if {_p} has the scoreboard tag "asgem.q.rubi.3":
                    set {-agem.has::%{_id}%::rubi} to 3
                if {_p} has the scoreboard tag "asgem.q.rubi.4":
                    set {-agem.has::%{_id}%::rubi} to 4
                if {_p} has the scoreboard tag "asgem.q.rubi.5":
                    set {-agem.has::%{_id}%::rubi} to 5
            if {_p} has the scoreboard tag "asgem.has.zafiro":
                add 1 to {_k}
                set {-agem.ran::%{_id}%::%{_k}%} to "zafiro"
                if {_p} has the scoreboard tag "asgem.q.zafiro.1":
                    set {-agem.has::%{_id}%::zafiro} to 1
                if {_p} has the scoreboard tag "asgem.q.zafiro.2":
                    set {-agem.has::%{_id}%::zafiro} to 2
                if {_p} has the scoreboard tag "asgem.q.zafiro.3":
                    set {-agem.has::%{_id}%::zafiro} to 3
                if {_p} has the scoreboard tag "asgem.q.zafiro.4":
                    set {-agem.has::%{_id}%::zafiro} to 4
                if {_p} has the scoreboard tag "asgem.q.zafiro.5":
                    set {-agem.has::%{_id}%::zafiro} to 5
            if {_p} has the scoreboard tag "asgem.has.jade":
                add 1 to {_k}
                set {-agem.ran::%{_id}%::%{_k}%} to "jade"
                if {_p} has the scoreboard tag "asgem.q.jade.1":
                    set {-agem.has::%{_id}%::jade} to 1
                if {_p} has the scoreboard tag "asgem.q.jade.2":
                    set {-agem.has::%{_id}%::jade} to 2
                if {_p} has the scoreboard tag "asgem.q.jade.3":
                    set {-agem.has::%{_id}%::jade} to 3
                if {_p} has the scoreboard tag "asgem.q.jade.4":
                    set {-agem.has::%{_id}%::jade} to 4
                if {_p} has the scoreboard tag "asgem.q.jade.5":
                    set {-agem.has::%{_id}%::jade} to 5
            if {_p} has the scoreboard tag "asgem.has.topacio":
                add 1 to {_k}
                set {-agem.ran::%{_id}%::%{_k}%} to "topacio"
                if {_p} has the scoreboard tag "asgem.q.topacio.1":
                    set {-agem.has::%{_id}%::topacio} to 1
                if {_p} has the scoreboard tag "asgem.q.topacio.2":
                    set {-agem.has::%{_id}%::topacio} to 2
                if {_p} has the scoreboard tag "asgem.q.topacio.3":
                    set {-agem.has::%{_id}%::topacio} to 3
                if {_p} has the scoreboard tag "asgem.q.topacio.4":
                    set {-agem.has::%{_id}%::topacio} to 4
                if {_p} has the scoreboard tag "asgem.q.topacio.5":
                    set {-agem.has::%{_id}%::topacio} to 5
            if {_p} has the scoreboard tag "asgem.has.amatista":
                add 1 to {_k}
                set {-agem.ran::%{_id}%::%{_k}%} to "amatista"
                if {_p} has the scoreboard tag "asgem.q.amatista.1":
                    set {-agem.has::%{_id}%::amatista} to 1
                if {_p} has the scoreboard tag "asgem.q.amatista.2":
                    set {-agem.has::%{_id}%::amatista} to 2
                if {_p} has the scoreboard tag "asgem.q.amatista.3":
                    set {-agem.has::%{_id}%::amatista} to 3
                if {_p} has the scoreboard tag "asgem.q.amatista.4":
                    set {-agem.has::%{_id}%::amatista} to 4
                if {_p} has the scoreboard tag "asgem.q.amatista.5":
                    set {-agem.has::%{_id}%::amatista} to 5
            if {_p} has the scoreboard tag "asgem.has.opalo":
                add 1 to {_k}
                set {-agem.ran::%{_id}%::%{_k}%} to "opalo"
                if {_p} has the scoreboard tag "asgem.q.opalo.1":
                    set {-agem.has::%{_id}%::opalo} to 1
                if {_p} has the scoreboard tag "asgem.q.opalo.2":
                    set {-agem.has::%{_id}%::opalo} to 2
                if {_p} has the scoreboard tag "asgem.q.opalo.3":
                    set {-agem.has::%{_id}%::opalo} to 3
                if {_p} has the scoreboard tag "asgem.q.opalo.4":
                    set {-agem.has::%{_id}%::opalo} to 4
                if {_p} has the scoreboard tag "asgem.q.opalo.5":
                    set {-agem.has::%{_id}%::opalo} to 5
            if {_p} has the scoreboard tag "asgem.has.onix":
                add 1 to {_k}
                set {-agem.ran::%{_id}%::%{_k}%} to "onix"
                if {_p} has the scoreboard tag "asgem.q.onix.1":
                    set {-agem.has::%{_id}%::onix} to 1
                if {_p} has the scoreboard tag "asgem.q.onix.2":
                    set {-agem.has::%{_id}%::onix} to 2
                if {_p} has the scoreboard tag "asgem.q.onix.3":
                    set {-agem.has::%{_id}%::onix} to 3
                if {_p} has the scoreboard tag "asgem.q.onix.4":
                    set {-agem.has::%{_id}%::onix} to 4
                if {_p} has the scoreboard tag "asgem.q.onix.5":
                    set {-agem.has::%{_id}%::onix} to 5
    set {_g} to {agem.gema::%{_id}%}
    if {_g} is set:
        agem_run({_p}, {_g}, "gemas/gui/gema")
        if {_p} has the scoreboard tag "asgem.g.rubi.1":
            set {-agem.gt::%{_id}%} to "rubi"
            set {-agem.gq::%{_id}%} to 1
        if {_p} has the scoreboard tag "asgem.g.rubi.2":
            set {-agem.gt::%{_id}%} to "rubi"
            set {-agem.gq::%{_id}%} to 2
        if {_p} has the scoreboard tag "asgem.g.rubi.3":
            set {-agem.gt::%{_id}%} to "rubi"
            set {-agem.gq::%{_id}%} to 3
        if {_p} has the scoreboard tag "asgem.g.rubi.4":
            set {-agem.gt::%{_id}%} to "rubi"
            set {-agem.gq::%{_id}%} to 4
        if {_p} has the scoreboard tag "asgem.g.rubi.5":
            set {-agem.gt::%{_id}%} to "rubi"
            set {-agem.gq::%{_id}%} to 5
        if {_p} has the scoreboard tag "asgem.g.zafiro.1":
            set {-agem.gt::%{_id}%} to "zafiro"
            set {-agem.gq::%{_id}%} to 1
        if {_p} has the scoreboard tag "asgem.g.zafiro.2":
            set {-agem.gt::%{_id}%} to "zafiro"
            set {-agem.gq::%{_id}%} to 2
        if {_p} has the scoreboard tag "asgem.g.zafiro.3":
            set {-agem.gt::%{_id}%} to "zafiro"
            set {-agem.gq::%{_id}%} to 3
        if {_p} has the scoreboard tag "asgem.g.zafiro.4":
