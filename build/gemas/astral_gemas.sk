        if {_p} has the scoreboard tag "asgem.g.topacio.1":
            set {-agem.gt::%{_id}%} to "topacio"
            set {-agem.gq::%{_id}%} to 1
        if {_p} has the scoreboard tag "asgem.g.topacio.2":
