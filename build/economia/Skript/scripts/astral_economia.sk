# Generado por datapack-src/economia.py (plan E1 18/11/2026). No editar a mano.
# Pagos de mobs, perdida de plata al morir, Banco Astral y rebase x100 de saldos.

options:
    radio: 64
    perdida: 0.5
    espera: 10
    eliteola: 10
    interes: 0.02
    interesmax: 2000000
    horas: 24
    escala: 100
    titulo: &8Banco Astral

