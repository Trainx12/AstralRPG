    set {-banco.titulo::depositar} to "&f"
    set {-banco.titulo::retirar} to "&f"
    set {-banco.titulo::mejorar} to "&f"
    set {-banco.titulo::movimiento} to "&f"
    set {-banco.titulo::cuenta} to "&f"
