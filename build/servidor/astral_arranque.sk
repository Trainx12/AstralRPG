# Arranque del servidor (23/11, pedido del dueno): los primeros 15 minutos despues de prender
# no entran jugadores (los OP si), para que todo termine de cargar. El reinicio diario lo hace el panel
# de Empower a las 05:00 (Argentina), con avisos 10/5/1 min antes.
options:
    minutos: 15

on skript start:
    set {-astral.arranque} to now

on connect:
    {-astral.arranque} is set
    player is not op
    # El dueno puede estar en /modo jugador (AstralDueno le saca el OP): igual entra.
    "%uuid of player%" is not "20e59728-e27a-35f1-9062-ab65fa0453b8"
    set {_pasado} to difference between {-astral.arranque} and now
    if {_pasado} < {@minutos} minutes:
        set {_falta} to ({@minutos} minutes) - {_pasado}
        kick player due to "&6&lAstralRPG&r%nl%&eEl servidor se esta terminando de prender.%nl%&fVolve a entrar en &a%{_falta}%&f.%nl%&7Despues de cada reinicio tarda unos {@minutos} minutos en estar listo."
